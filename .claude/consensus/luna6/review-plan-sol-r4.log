  1135	    (row.arm === input.leftArm || row.arm === input.rightArm));
  1136	  const leftRows = selected.filter((row) => row.arm === input.leftArm);
  1137	  const rightRows = selected.filter((row) => row.arm === input.rightArm);
  1138	  const rowKey = (row: D569AnalysisRow): string => `${String(row.seed)}:${String(row.rep)}`;
  1139	  const left = new Map(leftRows.map((row) => [rowKey(row), row]));
  1140	  const right = new Map(rightRows.map((row) => [rowKey(row), row]));
  1141	  if (left.size !== leftRows.length || right.size !== rightRows.length || left.size !== right.size ||
  1142	    [...left.keys()].some((key) => !right.has(key))) {
  1143	    throw new TypeError('Paired analysis requires one row per arm for every (encounter seed, rep).');
