  1155	    paired.map(({ leftRow, leftValues, rightValues }) => ({
  1156	      seed: leftRow.seed, value: leftValues[name] - rightValues[name],
  1157	    })), resamples, input.bootstrapSeed + 100 + index,
  1158	  )])) as D569PairAnalysisMetrics['pairedZeroInclusive'];
