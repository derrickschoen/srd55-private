  1003	function percentile(sorted: readonly number[], quantile: number): number {
  1004	  if (sorted.length === 0) return Number.NaN;
  1005	  const index = Math.min(sorted.length - 1, Math.max(0, Math.floor(quantile * sorted.length)));
  1006	  return sorted[index] ?? Number.NaN;
  1007	}
