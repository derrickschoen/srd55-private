  1009	function clusterInterval(
  1010	  clusters: ReadonlyMap<number, readonly number[]>,
  1011	  resamples: number,
  1012	  seed: number,
  1013	): D569Interval {
  1014	  const clusterRows = [...clusters.values()];
  1015	  if (clusterRows.length === 0) return { lower: Number.NaN, upper: Number.NaN };
  1016	  const random = mulberry32(seed);
  1017	  const draws = new Array<number>(resamples);
  1018	  for (let draw = 0; draw < resamples; draw += 1) {
  1019	    const sampled: number[] = [];
  1020	    for (let cluster = 0; cluster < clusterRows.length; cluster += 1) {
  1021	      const selected = clusterRows[Math.floor(random() * clusterRows.length)];
  1022	      if (selected !== undefined) sampled.push(...selected);
  1023	    }
  1024	    draws[draw] = mean(sampled);
  1025	  }
  1026	  draws.sort((left, right) => left - right);
  1027	  return { lower: percentile(draws, 0.025), upper: percentile(draws, 0.975) };
  1028	}
