  "spec": {
    "scenarioId": "hypnotic-pattern-cc",
    "purpose": "Mechanical guardrail: did the monster AI cast Hypnotic Pattern on the clustered PCs instead of choosing ordinary single-target damage?",
    "licensedCaster": {
      "name": "Incubus",
      "contentPackSourceKind": "srd",
      "source": "bundled SRD 5.2.1, Incubus statblock, page 301 / normalized text lines 21742-21787",
      "preparedSpell": "hypnotic-pattern",
      "availableSlot": { "level": 3, "remaining": 1 },
      "statblockUse": { "resource": "monster-spell:spellcasting:hypnotic-pattern", "remaining": 1 }
    },
    "humanReadableReasoning": [
      "One 66-HP Incubus faces four healthy 60-HP PCs. If it spends the turn on damage, it can make two Restless Touch attacks against only one PC; even two hits do not remove that PC, and all four PCs retain their next actions.",
      "Hypnotic Pattern can cover all four PCs in one legal 30-foot cube while leaving the Incubus outside. Each PC has a -2 Wisdom save against DC 15, so the control is expected to remove most of the opposing actions immediately.",
      "The PCs occupy the four corners of the cluster, 25 feet apart along each edge. A PC who resists must move and spend an action to wake only one affected ally; that rescue trades away the successful PC's own action and cannot restore the whole party at once.",
      "With no monster ally available to be caught or to exploit plain damage, mass incapacitation is the decisive action-economy play and Restless Touch is the deliberately inferior comparison."
    ],
    "positions": {
      "pcCorners": [
        { "combatantId": "combatant:d432-fighter", "column": 2, "row": 2 },
        { "combatantId": "combatant:d432-cleric", "column": 7, "row": 2 },
