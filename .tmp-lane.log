+  { id: 'statblock:priest-acolyte', name: 'Priest Acolyte', challengeRating: '1/4', source: [{ path: 'docs/srd/full/srd-5.2.1.txt', lineStart: 20706, lineEnd: 20740 }], statblock: PRIEST_ACOLYTE },
