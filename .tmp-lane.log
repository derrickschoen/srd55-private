+function validateAction<T extends MonsterAction | MonsterBonusAction>(action: T): T {
+  switch (action.kind) {
+    case 'attack':
+      nonEmptyText(action.id, 'Attack id');
+      nonEmptyText(action.name, 'Attack name');
