+const SRD_PATH = 'docs/srd/full/srd-5.2.1.txt' as const;
+const present = <T>(value: T): DecodedField<T> => ({ kind: 'present', value });
+const notListed = <T>(field: string): DecodedField<T> => ({
+  kind: 'absent',
