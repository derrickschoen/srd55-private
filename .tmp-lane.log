+    },
+  },
+  {
+    condition: 'Frightened',
+    inventorySource: 'docs/srd/source/domain-vocabularies.txt:30-54',
+    mechanicsSource: 'docs/srd/full/srd-5.2.1.txt:11740-11747',
+    mechanicalClauseCount: 2,
