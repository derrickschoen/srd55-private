+  | {
+      readonly kind: 'roll_mode';
+      readonly roll: 'attack_by' | 'attack_against' | 'ability_check' | 'initiative' | 'dexterity_save';
+      readonly mode: Exclude<RollMode, 'normal'>;
+      readonly predicate:
+        | 'always'
+        | 'source_visible'
+        | 'target_not_source'
