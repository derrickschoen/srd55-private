+  kind: 'attack', id, name, attackBonus, delivery: { kind: 'melee', reachFeet },
+  damage: [{ average, dice: { count, sides, modifier }, type, trigger: 'always' }], onHit: null,
+});
+
+const ranged = (
+  id: string,
+  name: string,
+  attackBonus: number,
+  average: number,
+  count: number,
+  sides: 4 | 6 | 8 | 10 | 12 | 20,
