+    mechanicalClauseCount: 3,
+    mechanics: {
+      kind: 'invisible',
+      initiative: 'advantage',
+      cannotBeTargetedBySightRequirement: true,
+      carriedEquipmentConcealed: true,
+      attacksBy: 'advantage',
+      attacksAgainst: 'disadvantage',
+      seenCreatureIgnoresAttackBenefit: true,
