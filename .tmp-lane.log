import {
  abilities,
  conditionType,
  creatureSize,
  creatureType,
  damageType as domainDamageType,
  type Ability,
  type ConditionType,
  type CreatureSize,
  type CreatureType,
  type DamageType as DomainDamageType,
} from '../domain/enums';
import type { DamageResponse } from './resolution';
import { SPELL_MANIFEST, type SpellManifestStatus } from './spells/manifest';
import {
  armorClass,
  damageType,
  feet,
