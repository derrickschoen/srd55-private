# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/
# Rules are applied top-to-bottom; every matching block contributes.

# Hashed, content-addressed build assets (JS/CSS/wasm under /assets/) never change
# for a given URL — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Any wasm served from the root (e.g. the SQLite binary) is also content-hashed.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# Never cache the entry document, so a new deploy is picked up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # NOTE: OPFS + the opfs-sahpool VFS work WITHOUT cross-origin isolation, so
  # COOP/COEP are intentionally omitted (that was the whole reason for choosing
  # sahpool). To later enable SharedArrayBuffer / threaded wasm / the SAB OPFS VFS,
  # uncomment the next two lines and confirm every subresource is same-origin or
  # sends Cross-Origin-Resource-Policy:
  # Cross-Origin-Opener-Policy: same-origin
  # Cross-Origin-Embedder-Policy: require-corp
