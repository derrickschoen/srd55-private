+  if (life === 'dying' && successes >= DEATH_SAVE_RESOLUTION_COUNT) {
+    life = 'stable';
+  }
+  if (life === 'dying' && failures >= DEATH_SAVE_RESOLUTION_COUNT) {
+    life = 'dead';
+  }
