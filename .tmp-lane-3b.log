+    ...before,
+    hitPoints,
+    life,
+    deathSaves: life === 'dying' ? { successes, failures } : null,
+  });
+  emit(context, {
+    type: 'death_save_resolved',
+    visibility: 'dm_only',
+    combatant: id,
+    roll,
+    outcome,
+    successes,
+    failures,
+    lifeState: life,
+  });
+}
