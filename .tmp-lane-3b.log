+    life = 'living';
+    outcome = 'natural_20';
+  } else if (roll >= DEATH_SAVE_SUCCESS_FLOOR) {
+    successes += 1;
+    outcome = 'success';
+  } else {
+    failures += 1;
+    outcome = 'failure';
+  }
+
