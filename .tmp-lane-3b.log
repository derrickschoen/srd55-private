+const DEATH_SAVE_SUCCESS_FLOOR = 10;
+const DEATH_SAVE_RESOLUTION_COUNT = 3;
+const NATURAL_ONE_FAILURES = 2;
+const NATURAL_TWENTY_HIT_POINTS = 1;
