+      request.critical,
+    );
+    concentrationCheck(context, command.target, damageResult.total);
+  }
+  emit(context, {
+    type: 'attack_resolved',
+    actor: command.actor,
+    target: command.target,
+    attack,
+    damage: damageResult,
+  });
