+  if (life === 'dying' && failures >= DEATH_SAVE_RESOLUTION_COUNT) {
+    life = 'dead';
+  }
+  context.state = replaceCombatant(context.state, {
+    ...before,
+    hitPoints,
+    life,
+    deathSaves: life === 'dying' ? { successes, failures } : null,
+  });
