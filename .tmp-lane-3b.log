+    failures += NATURAL_ONE_FAILURES;
+    outcome = 'natural_1';
+  } else if (roll === 20) {
+    hitPoints = NATURAL_TWENTY_HIT_POINTS;
+    life = 'living';
+    outcome = 'natural_20';
+  } else if (roll >= DEATH_SAVE_SUCCESS_FLOOR) {
+    successes += 1;
+    outcome = 'success';
+  } else {
+    failures += 1;
+    outcome = 'failure';
+  }
