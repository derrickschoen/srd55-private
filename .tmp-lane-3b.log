+function resolveDeathSave(context: ReductionContext, id: CombatantId): void {
+  const before = combatant(context.state, id);
+  if (
+    before.life !== 'dying' ||
+    before.hitPoints !== 0 ||
+    !before.profile.rules.usesDeathSaves
