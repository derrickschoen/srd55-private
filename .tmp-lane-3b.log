+        bonusActionAvailable: true,
+        reactionAvailable: true,
+        movement: startTurnMovement(feet(effectiveSpeed(context.state, id))),
+        disengaging: false,
+        dodging: false,
+      },
+    });
+  }
+}
+
+function processAttack(
+  context: ReductionContext,
+  command: Extract<
+    EncounterCommand,
