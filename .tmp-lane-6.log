nt-weight: 800;\n  background: transparent;\n}\n\n.slot-attention {\n  background: #fff7df;\n}\n\n.slot-attention-detail td {\n  border-bottom-color: #d9b55d;\n}\n\n.slot-attention-detail p {\n  display: inline-block;\n  max-width: 38rem;\n  margin: 0 0.6rem 0 0;\n}\n\n.slot-attention-detail input {\n  display: inline-block;\n  max-width: 15rem;\n  margin: 0 0.35rem;\n}\n\n.placeholder-badge {\n  display: inline-block;\n  margin: 0.3rem 0 0 0.35rem;\n  border: 1px solid #b7791f;\n  border-radius: 999px;\n  padding: 0.12rem 0.4rem;\n  color: #744210;\n  background: #fff3c4;\n  font-size: 0.68rem;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.spell-picker {\n  position: relative;\n  display: inline-block;\n  min-width: 12rem;\n}\n\n.spell-options {\n  position: absolute;\n  z-index: 30;\n  top: calc(100% + 0.25rem);\n  left: 0;\n  width: min(24rem, 80vw);\n  max-height: 17rem;\n  padding: 0.25rem;\n  overflow: auto;\n  border: 1px solid #aaa296;\n  border-radius: 0.4rem;\n  background: #fff;\n  box-shadow: 0 0.5rem 1.3rem rgb(41 34 26 / 20%);\n}\n\n.spell-option {\n  display: grid;\n  width: 100%;\n  gap: 0.15rem;\n  padding: 0.55rem;\n  border: 0;\n  border-radius: 0.25rem;\n  text-align: left;\n  background: transparent;\n}\n\n.spell-option small {\n  color: var(--planner-ink-soft);\n}\n\n.spell-option:hover,\n.spell-option.is-active {\n  background: #f0e7ff;\n}\n\n.spell-options-status {\n  margin: 0;\n  padding: 0.55rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.75rem;\n}\n\n.save-point-form {\n  display: flex;\n  align-items: end;\n  gap: 0.55rem;\n  margin-top: 0.8rem;\n}\n\n.save-point-form label {\n  flex: 1;\n}\n\n.save-point-list li {\n  border-width: 0 0 1px;\n  border-radius: 0;\n}\n\n.operation-list li {\n  padding: 0.35rem 0;\n  font-size: 0.75rem;\n}\n\n.report-metrics,\n.dice-metrics {\n  display: grid;\n  margin: 0.8rem 0 0;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.45rem;\n}\n\n.report-metrics div,\n.dice-metrics d