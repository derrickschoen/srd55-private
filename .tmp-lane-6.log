+            : candidate,
+        ),
+      };
+      emit(context, {
+        type: 'adjudicated',
+        target: command.target,
+        reasoning: command.reasoning.trim(),
+        consequence: {
+          kind: 'position',
+          from: { ...existing.position },
+          to: { ...consequence.to },
+        },
+      });
