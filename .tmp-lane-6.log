+.dm-adjudication button {
+  margin: 0.25rem;
+}
+
+.dm-adjudication,
+.dm-controller-assignments {
+  display: grid;
+  gap: 0.5rem;
+  max-width: 32rem;
+}
+
+.encounter-log [data-event-type='adjudicated'] {
+  color: #ffb454;
+  font-weight: 800;
+}
+
 .vtt-shell [hidden] {
