nmax(0, 2fr);\n  }\n}\n\n@media print {\n  .build-report-page {\n    color: #000;\n    background: #fff;\n  }\n\n  .report-controls {\n    display: none;\n  }\n\n  .report-content {\n    width: auto;\n    padding: 0;\n  }\n\n  .ability-card,\n  .report-panel,\n  .preparation-callout,\n  .duplicate-card,\n  .invalid-list li {\n    color: #000;\n    border-color: #000;\n    background: #fff;\n    box-shadow: none;\n    break-inside: avoid-page;\n    page-break-inside: avoid;\n  }\n\n  .report-muted,\n  .empty-value,\n  .invalid-list p {\n    color: #333;\n  }\n\n  .build-report-page .srd-attribution {\n    color: #000;\n    border-color: #000;\n    break-inside: avoid-page;\n    page-break-inside: avoid;\n  }\n\n  .report-panel h2,\n  .report-panel h3 {\n    break-after: avoid-page;\n    page-break-after: avoid;\n  }\n}\n"],["STYLE",{},".application-shell {\n  min-height: 100vh;\n  color: #1c2025;\n  background:\n    radial-gradient(circle at top right, rgb(124 58 32 / 8%), transparent 28rem),\n    #f5f1e8;\n}\n\n.dark .application-shell {\n  color: #f5f1e8;\n  background:\n    radial-gradient(circle at top right, rgb(167 139 250 / 10%), transparent 28rem),\n    #181512;\n}\n\n.app-header {\n  border-bottom: 1px solid #cfc6b6;\n  background: rgb(255 255 255 / 82%);\n  backdrop-filter: blur(0.75rem);\n}\n\n.dark .app-header {\n  border-color: #403a34;\n  background: rgb(30 27 24 / 88%);\n}\n\n.header-content,\n.character-list-main {\n  width: min(100% - 2rem, 72rem);\n  margin-inline: auto;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding-block: 0.9rem;\n}\n\n.header-title {\n  min-width: 0;\n}\n\n.brand-link {\n  display: inline-flex;\n  min-height: 2.75rem;\n  align-items: center;\n  color: #6d28d9;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n}\n\n.dark .brand-link {\n  color: #c4b5fd;\n}\n\n.header-title h1,\n.header-title p {\n  margin: 0;\n}\n\n.header-title h1 {\n  overflow: hidden;\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 1.5rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.header-title p,\n.storage-status,\n.card-heading p,\n.empty-state p {\n  color: #665f56;\n  font-size: 0.875rem;\n}\n\n.dark .header-title p,\n.dark .storage-status,\n.dark .card-heading p,\n.dark .empty-state p {\n  color: #b9b0a5;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.75rem;\n}\n\n.storage-status {\n  max-width: 22rem;\n  text-align: right;\n}\n\n.character-list-main {\n  padding-block: 1.5rem 3rem;\n}\n\n.panel {\n  border: 1px solid #d7cebe;\n  border-radius: 0.75rem;\n  background: rgb(255 255 255 / 88%);\n  box-shadow: 0 0.25rem 1rem rgb(54 45 34 / 5%);\n}\n\n.dark .panel {\n  border-color: #403a34;\n  background: #24201c;\n  box-shadow: none;\n}\n\n/* The primary action (D42): the guided front door. */\n.start-panel {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem;\n}\n\n.start-copy h2 {\n  margin: 0;\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 1.125rem;\n}\n\n.start-copy p {\n  margin: 0.25rem 0 0;\n  color: #665f56;\n  font-size: 0.875rem;\n}\n\n.dark .start-copy p {\n  color: #b9b0a5;\n}\n\n.start-panel .button-primary {\n  flex: none;\n}\n\n/* The escape hatch (D42): reachable, collapsed, visibly secondary. */\n.advanced-create {\n  margin-top: 1rem;\n  padding: 0.8rem 1rem 1rem;\n}\n\n.advanced-create summary {\n  min-height: 2.75rem;\n  align-content: center;\n  cursor: pointer;\n  font-size: 0.875rem;\n  font-weight: 700;\n}\n\n.advanced-note {\n  margin: 0.75rem 0 0;\n  color: #665f56;\n  font-size: 0.875rem;\n}\n\n.dark .advanced-note {\n  color: #b9b0a5;\n}\n\n.create-panel {\n  display: flex;\n  align-items: end;\n  gap: 0.75rem;\n  padding: 1rem 0 0;\n}\n\n.create-panel label {\n  display: grid;\n  flex: 1;\n  gap: 0.35rem;\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.field,\n.transfer-control input,\n.transfer-control select {\n  width: 100%;\n  min-height: 2.75rem;\n  border: 1px solid #a99d8c;\n  border-radius: 0.45rem;\n  padding: 0.55rem 0.7rem;\n  color: inherit;\n  background: #fff;\n}\n\n.dark .field,\n.dark .transfer-control input,\n.dark .transfer-control select {\n  border-color: #62584e;\n  background: #181512;\n}\n\n.button-primary,\n.button-secondary,\n.button-danger,\n.transfer-panel button {\n  display: inline-flex;\n  min-height: 2.75rem;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 0.45rem;\n  padding: 0.55rem 0.8rem;\n  font-weight: 650;\n  line-height: 1.2;\n  text-decoration: none;\n  cursor: pointer;\n}\n\n.button-primary {\n  color: #fff;\n  background: #6d28d9;\n}\n\n.button-secondary,\n.transfer-panel button {\n  border-color: #b8ac9b;\n  color: inherit;\n  background: transparent;\n}\n\n.button-danger {\n  border-color: #c7756c;\n  color: #8c1d18;\n  background: transparent;\n}\n\n.dark .button-danger {\n  color: #fca5a5;\n}\n\nbutton:disabled,\nselect:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n\n.action-error,\n.transfer-error {\n  color: #8c1d18;\n}\n\n.dark .action-error,\n.dark .transfer-error {\n  color: #fca5a5;\n}\n\n.action-error {\n  margin: 0.75rem 0 0;\n}\n\n.transfer-panel {\n  margin-block: 1rem 1.5rem;\n  border: 1px solid #d7cebe;\n  border-radius: 0.6rem;\n  padding: 0.8rem 1rem;\n}\n\n.share-panel {\n  margin-block: 1rem;\n  padding: 1rem;\n}\n\n/* Author `display` rules outrank the UA stylesheet's `[hidden] { display: none }`,\n   so `.button-secondary`'s `display: inline-flex` would otherwise keep a hidden\n   share action on screen — letting a stale link stay copyable after switching\n   characters. Same fix as `.dice-profile-controls [hidden]`. */\n.share-panel [hidden] {\n  display: none !important;\n}\n\n.share-columns {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1.5rem;\n}\n\n.share-column {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.55rem;\n}\n\n.share-column h3,\n.share-column p,\n.share-status,\n.share-preview p {\n  margin: 0;\n}\n\n.share-option {\n  display: flex;\n  min-height: 2.75rem;\n  align-items: center;\n  gap: 0.45rem;\n  font-size: 0.85rem;\n  cursor: pointer;\n}\n\n.share-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.share-link-output {\n  font-family: monospace;\n  font-size: 0.72rem;\n}\n\n.share-preview {\n  width: 100%;\n  border-left: 0.25rem solid #6d28d9;\n  padding: 0.75rem;\n  background: rgb(109 40 217 / 7%);\n}\n\n.share-preview h3 {\n  margin: 0 0 0.35rem;\n}\n\n.share-preview button {\n  margin-top: 0.75rem;\n}\n\n.share-qr {\n  max-width: 100%;\n  height: auto;\n  border: 0.5rem solid #fff;\n}\n\n.dark .transfer-panel {\n  border-color: #403a34;\n}\n\n.transfer-panel summary {\n  min-height: 2.75rem;\n  align-content: center;\n  cursor: pointer;\n  font-weight: 700;\n}\n\n.transfer-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 1rem;\n  margin-top: 1rem;\n}\n\n.transfer-control {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 0.45rem;\n  font-size: 0.8rem;\n  font-weight: 600;\n}\n\n.transfer-control input {\n  overflow: hidden;\n  font-size: 0.75rem;\n}\n\n.transfer-status {\n  min-height: 1.25rem;\n  margin: 0.85rem 0 0;\n  font-size: 0.85rem;\n}\n\n.transfer-technical-detail {\n  display: block;\n  margin-top: 0.25rem;\n  font-size: 0.75rem;\n}\n\n.character-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 1rem;\n}\n\n.character-card {\n  display: flex;\n  min-height: 12rem;\n  flex-direction: column;\n  padding: 1rem;\n}\n\n.card-heading {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.card-heading h2,\n.card-heading p,\n.class-summary {\n  margin: 0;\n}\n\n.card-heading h2 {\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 1.125rem;\n}\n\n.status-badge {\n  flex: none;\n  border-radius: 999px;\n  padding: 0.25rem 0.5rem;\n  font-size: 0.75rem;\n  font-weight: 700;\n}\n\n.status-ok {\n  color: #166534;\n  background: #dcfce7;\n}\n\n.status-warning {\n  color: #854d0e;\n  background: #fef3c7;\n}\n\n.class-summary {\n  flex: 1;\n  padding-block: 1rem;\n  color: #4f4942;\n  font-size: 0.875rem;\n  line-height: 1.6;\n}\n\n.dark .class-summary {\n  color: #d2cbc3;\n}\n\n.card-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  border-top: 1px solid #e0d8ca;\n  padding-top: 0.85rem;\n}\n\n.dark .card-actions {\n  border-color: #403a34;\n}\n\n.card-actions .button-danger {\n  margin-left: auto;\n}\n\n.empty-state {\n  padding: 4rem 1rem;\n  text-align: center;\n}\n\n.empty-mark {\n  font-size: 2rem;\n}\n\n.empty-state h2,\n.empty-state p {\n  margin: 0.4rem 0 0;\n}\n\n@media (max-width: 56rem) {\n  .character-grid,\n  .transfer-grid,\n  .share-columns {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .storage-status {\n    display: none;\n  }\n}\n\n@media (max-width: 38rem) {\n  .header-title p {\n    display: block;\n  }\n\n  .create-panel,\n  .start-panel,\n  .header-content {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .header-actions {\n    justify-content: space-between;\n  }\n\n  .storage-status {\n    display: block;\n    text-align: left;\n  }\n\n  .character-grid,\n  .transfer-grid,\n  .share-columns {\n    grid-template-columns: 1fr;\n  }\n}\n\n.card-badges {\n  display: flex;\n  flex: none;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 0.25rem;\n}\n\n/* Outstanding work is not a warning, so it borrows neither the warning amber\n   nor the ok green, and a settled character shows one neutral pill rather than\n   a second green tick beside .status-ok. */\n.status-outstanding {\n  color: #1e3a8a;\n  background: #dbeafe;\n}\n\n.status-settled {\n  color: #475569;\n  background: #f1f5f9;\n}\n\n.status-catalog-gap {\n  color: #6b21a8;\n  background: #f3e8ff;\n}\n"],["STYLE",{},"/*\n * The guided builder is plain and labelled on the sheet's terms (D4): the step\n * list and one panel, nothing hidden — no `display: none`, no zero opacity,\n * no off-screen positioning.\n */\n.guided-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  max-width: 48rem;\n  margin: 0 auto;\n  padding: 1.5rem 1rem 3rem;\n}\n\n.guided-header h1 {\n  margin: 0.75rem 0 0.25rem;\n}\n\n.guided-steps {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  counter-reset: guided-step;\n}\n\n.guided-step {\n  counter-increment: guided-step;\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 1rem;\n  padding: 0.25rem 0.75rem;\n  font-size: 0.9rem;\n}\n\n.guided-step::before {\n  content: counter(guided-step) '. ';\n  font-variant-numeric: tabular-nums;\n  opacity: 0.7;\n}\n\n.guided-step-current {\n  border-color: var(--accent, #333);\n  font-weight: 700;\n}\n\n.guided-panel {\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.5rem;\n  padding: 1rem;\n}\n\n.guided-panel > h2 {\n  margin-top: 0;\n}\n\n.guided-nav {\n  margin-bottom: 0;\n}\n\n/* The class chooser (A3). The name form is not styled into or out of view —\n   it is created only after a class is chosen, so there is nothing to hide. */\n.guided-class-options {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));\n  gap: 0.75rem;\n  margin: 1rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.guided-class-card {\n  display: flex;\n  width: 100%;\n  flex-direction: column;\n  gap: 0.25rem;\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.5rem;\n  padding: 0.75rem;\n  color: inherit;\n  background: transparent;\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.guided-class-card[aria-pressed='true'] {\n  border-color: var(--accent, #333);\n  box-shadow: inset 0 0 0 1px var(--accent, #333);\n  font-weight: 700;\n}\n\n.guided-class-card:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n\n.guided-class-hit-die {\n  font-size: 0.85rem;\n  opacity: 0.8;\n}\n\n.guided-name-form {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  gap: 0.75rem;\n  margin-top: 1.25rem;\n  border-top: 1px solid var(--border, #c9c9c9);\n  padding-top: 1rem;\n}\n\n.guided-chosen-class {\n  width: 100%;\n  margin: 0;\n  font-weight: 600;\n}\n\n.guided-name-form label {\n  display: grid;\n  flex: 1 1 14rem;\n  gap: 0.35rem;\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.guided-name-input {\n  min-height: 2.4rem;\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.45rem;\n  padding: 0.5rem 0.7rem;\n  color: inherit;\n  background: transparent;\n  font: inherit;\n}\n\n.guided-submit {\n  min-height: 2.4rem;\n  border: 1px solid var(--accent, #333);\n  border-radius: 0.45rem;\n  padding: 0.5rem 0.9rem;\n  color: #fff;\n  background: var(--accent, #333);\n  font: inherit;\n  font-weight: 650;\n  cursor: pointer;\n}\n\n.guided-submit:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n\n.guided-error {\n  margin: 0.75rem 0 0;\n  color: #8c1d18;\n}\n\n.dark .guided-error {\n  color: #fca5a5;\n}\n\n/* The species step (A4). Cards are containers with an explicit apply button,\n   not one giant clickable surface — the D33 disclosures are flow content. */\n.guided-species-options {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));\n  gap: 0.75rem;\n  margin: 1rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.guided-species-card {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.5rem;\n  padding: 0.75rem;\n}\n\n.guided-species-name {\n  margin: 0;\n  font-size: 1rem;\n}\n\n.guided-species-choices p,\n.guided-species-choices-none,\n.guided-species-lineage-gated {\n  margin: 0;\n  font-size: 0.85rem;\n  opacity: 0.85;\n}\n\n.guided-species-choices ul {\n  margin: 0.25rem 0 0;\n  padding-left: 1.1rem;\n  font-size: 0.85rem;\n}\n\n.guided-species-configured-choice {\n  border-top: 1px solid rgba(127, 127, 127, 0.35);\n  padding-top: 0.5rem;\n}\n\n.guided-species-configured-choice > h4,\n.guided-lineage-option-disclosure h4 {\n  margin: 0;\n}\n\n.guided-lineage-option-disclosure {\n  margin-top: 0.45rem;\n}\n\n.guided-lineage-option-disclosure ul {\n  margin: 0.25rem 0 0;\n  padding-left: 1.2rem;\n  font-size: 0.85rem;\n}\n\n.guided-lineage-options {\n  display: grid;\n  gap: 0.75rem;\n  margin: 1rem 0;\n  border: 0;\n  padding: 0;\n}\n\n.guided-lineage-option,\n.guided-species-choice-summary {\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.5rem;\n  padding: 0.75rem;\n}\n\n.guided-lineage-option > label {\n  margin-left: 0.4rem;\n  font-weight: 650;\n}\n\n.guided-lineage-ability {\n  display: block;\n  width: min(100%, 24rem);\n  margin: 0.35rem 0 1rem;\n  padding: 0.45rem 0.55rem;\n  font: inherit;\n}\n\n.guided-lineage-spell {\n  margin-bottom: 1rem;\n}\n\n.guided-lineage-spell-help,\n.guided-status {\n  font-size: 0.9rem;\n}\n\n.guided-species-change {\n  min-height: 2.4rem;\n  border: 1px solid var(--accent, #333);\n  border-radius: 0.45rem;\n  padding: 0.5rem 0.9rem;\n  background: transparent;\n  color: inherit;\n  font: inherit;\n  font-weight: 650;\n  cursor: pointer;\n}\n\n/* The abilities step (B1). Warnings are STATUS TEXT (D49): styled to be\n   seen, never wired to any control state — the submit button stays live. */\n.guided-ability-methods {\n  margin: 0 0 1rem;\n  border: 1px solid rgba(127, 127, 127, 0.4);\n  border-radius: 0.45rem;\n  padding: 0.75rem 1rem;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.guided-ability-method {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.guided-ability-scores {\n  display