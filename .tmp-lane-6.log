iant-numeric: tabular-nums;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.sheet-resource-track {\n  display: inline-flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem;\n  margin-left: 0.65rem;\n  vertical-align: middle;\n}\n\n.sheet-resource-box {\n  width: 1rem;\n  height: 1rem;\n  box-sizing: border-box;\n  border: 1px solid currentColor;\n  background: #fff;\n}\n\n.sheet-resource-remaining {\n  font-weight: 600;\n}\n\n.sheet-resource-remaining-line {\n  width: 4rem;\n  height: 1em;\n  border-bottom: 1px solid currentColor;\n}\n\n.sheet-formula {\n  margin: 0.15rem 0 0;\n  font-size: 0.85rem;\n  opacity: 0.8;\n}\n\n.sheet-spell-group + .sheet-spell-group {\n  margin-top: 1rem;\n}\n\n.sheet-spell-group-heading {\n  margin: 0 0 0.5rem;\n  font-size: 1.05rem;\n}\n\n.sheet-spell-statistics {\n  margin-bottom: 0.65rem;\n}\n\n.sheet-spell-statistics p {\n  margin: 0.15rem 0;\n}\n\n.sheet-spell-statistics-label {\n  font-weight: 600;\n}\n\n.sheet-spellbook {\n  padding-top: 0.65rem;\n  margin-top: 0.65rem;\n  border-top: 1px solid var(--border, #c9c9c9);\n}\n\n.sheet-note,\n.sheet-total {\n  font-size: 0.9rem;\n}\n\n.sheet-gaps dt {\n  font-weight: 600;\n  margin-top: 0.5rem;\n}\n\n.sheet-gaps dd {\n  margin: 0.15rem 0 0;\n  font-size: 0.9rem;\n}\n\n#character-sheet-facts {\n  display: block;\n  white-space: pre-wrap;\n  font-family: ui-monospace, monospace;\n  font-size: 0.75rem;\n  max-height: 24rem;\n  overflow: auto;\n  border: 1px dashed var(--border, #c9c9c9);\n  padding: 0.5rem;\n}\n\n@media screen {\n  .sheet-shell,\n  .sheet-header,\n  .sheet-panel,\n  .sheet-number,\n  .sheet-numbers dt,\n  .sheet-numbers dd {\n    min-width: 0;\n  }\n\n  .sheet-header {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(14rem, 1fr));\n    gap: 0.65rem;\n  }\n\n  .sheet-header h1 {\n    grid-column: 1 / -1;\n    overflow-wrap: anywhere;\n  }\n\n  .sheet-print-options {\n    grid-column: 1 / -1;\n  }\n\n  .sheet-panel :is(h2, p, li, dt, dd) {\n  