diff --git a/src/combat/coordinator.ts b/src/combat/coordinator.ts
index 0d003dc1cda868b8a945526e78a7b779b8c9d7fe..ae43107368b245db181a0a0ffeede95abe51f850
--- a/src/combat/coordinator.ts
+++ b/src/combat/coordinator.ts
@@ -1,4 +1,5 @@
 import {
