+        tokens: context.state.tokens.map((candidate) =>
+          candidate.combatantId === command.target
+            ? { ...candidate, position: { ...consequence.to } }
+            : candidate,
+        ),
+      };
+      emit(context, {
+        type: 'adjudicated',
+        target: command.target,
+        reasoning: command.reasoning.trim(),
+        consequence: {
+          kind: 'position',
+          from: { ...existing.position },
+          to: { ...consequence.to },
