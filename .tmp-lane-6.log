play: grid;\n  margin-top: 0.55rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.55rem;\n}\n\n.dice-profile-controls [hidden] {\n  display: none !important;\n}\n\n.dice-selected-source,\n.dice-field-note {\n  display: block;\n  margin-top: 0.25rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.68rem;\n  font-weight: 500;\n  text-transform: none;\n}\n\n.dice-effects {\n  display: grid;\n  margin-top: 0.8rem;\n  padding: 0.65rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.55rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.4rem;\n  font-size: 0.78rem;\n}\n\n.dice-actions {\n  margin-top: 0.7rem;\n}\n\n.dice-actions label {\n  flex: 1;\n}\n\n.dice-roll-result {\n  display: block;\n  margin-top: 0.7rem;\n  padding: 0.65rem;\n  border-radius: 0.4rem;\n  color: #442369;\n  background: #f0e7ff;\n  font-weight: 700;\n}\n\n.dice-roll-result h3 {\n  display: inline;\n  margin-right: 0.65rem;\n}\n\n.dice-roll-result code {\n  font-size: 0.72rem;\n}\n\n.dice-trace {\n  display: grid;\n  padding: 0;\n  margin: 0.65rem 0 0;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n  list-style: none;\n}\n\n.dice-trace li {\n  padding: 0.55rem;\n  border: 1px solid #c4a7df;\n  border-radius: 0.35rem;\n  background: var(--planner-panel);\n  font-size: 0.75rem;\n}\n\n.dice-trace p,\n.dice-stop,\n.dice-profile-note,\n.dice-assumptions p {\n  margin: 0.35rem 0 0;\n  font-size: 0.72rem;\n  font-weight: 500;\n}\n\n.dice-profile-note {\n  padding: 0.55rem;\n  border-radius: 0.35rem;\n  background: #eee9e0;\n}\n\n.dice-profile-note:empty {\n  display: none;\n}\n\n.dice-assumptions {\n  margin-top: 0.75rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.75rem;\n}\n\n@media (max-width: 70rem) {\n  .planner-layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .planner-sidebar {\n    position: static;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .source-add-form {\n    grid-template-col