+}
+
+.encounter-token[data-adjudicated='true'] {
+  border-color: #ffb454;
+  box-shadow: 0 0 0 4px #b34a1c;
+}
+
+.active-pc-panel,
+.encounter-controls,
+.dm-pending-request,
+.dm-adjudication,
+.dm-controller-assignments {
+  margin: 1rem 0;
+  padding: 0.8rem;
+  border: 1px solid #3e4961;
+  background: #171b26;
+}
+
+.encounter-controls button,
+.dm-pending-request button,
+.dm-adjudication button {
+  margin: 0.25rem;
+}
+
+.dm-adjudication,
+.dm-controller-assignments {
+  display: grid;
+  gap: 0.5rem;
+  max-width: 32rem;
+}
+
+.encounter-log [data-event-type='adjudicated'] {
