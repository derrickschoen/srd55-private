 function processCommand(context: ReductionContext, command: EncounterCommand): void {
   switch (command.type) {
+    case 'adjudicate': {
+      if (command.reasoning.trim().length === 0) {
+        throw new EncounterRuleError('An adjudication requires DM reasoning.');
+      }
