+      };
+      emit(context, {
+        type: 'adjudicated',
+        target: command.target,
+        reasoning: command.reasoning.trim(),
+        consequence: {
+          kind: 'position',
+          from: { ...existing.position },
+          to: { ...consequence.to },
+        },
+      });
+      return;
+    }
     case 'cast_spell':
       processSpellCast(context, command);
       return;
