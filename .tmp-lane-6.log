+          ? 'living'
+          : subject.profile.rules.usesDeathSaves
+            ? 'dying'
+            : 'dead';
+        context.state = replaceCombatant(context.state, {
+          ...subject,
+          hitPoints: after,
+          life,
+          deathSaves: life === 'dying'
+            ? subject.deathSaves ?? { successes: 0, failures: 0 }
+            : null,
+        });
+        emit(context, {
