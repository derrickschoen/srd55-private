ap: wrap;\n  gap: 0.35rem 0.9rem;\n  grid-column: 1 / -1;\n}\n\n.weapon-toggles label {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n}\n\n.weapon-form-controls {\n  display: flex;\n  gap: 0.5rem;\n  margin-top: 0.75rem;\n}\n\n.weapon-form-error {\n  margin: 0.5rem 0 0;\n  color: var(--planner-accent);\n}\n\n/* --- attack profiles ------------------------------------------------------ */\n\n.attack-profiles {\n  margin-top: 1rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--planner-border);\n}\n\n.attack-profiles h3 {\n  margin: 0 0 0.35rem;\n  font-size: 0.95rem;\n}\n\n.attack-profiles > p {\n  margin: 0 0 0.6rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.84rem;\n}\n\n.attack-profile-warning {\n  color: var(--planner-accent);\n  font-weight: 600;\n}\n\n.attack-weapon {\n  margin-bottom: 0.85rem;\n  padding: 0.55rem 0.7rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.35rem;\n}\n\n.attack-weapon h4 {\n  margin: 0 0 0.3rem;\n  font-size: 0.9rem;\n}\n\n.attack-weapon-derived {\n  margin: 0 0 0.5rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n}\n\n.attack-profile + .attack-profile {\n  margin-top: 0.7rem;\n  padding-top: 0.7rem;\n  border-top: 1px dashed var(--planner-border);\n}\n\n.attack-profile h5 {\n  margin: 0 0 0.3rem;\n  font-size: 0.84rem;\n}\n\n.attack-profile select {\n  margin-bottom: 0.35rem;\n}\n\n.attack-profile-numbers {\n  margin: 0 0 0.3rem;\n  font-weight: 600;\n  font-size: 0.88rem;\n}\n\n.attack-profile-reason,\n.attack-profile-count {\n  margin: 0 0 0.25rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n}\n\n.attack-profile-conditions,\n.attack-profile-notes,\n.attack-profile-unresolved {\n  margin: 0.25rem 0 0;\n  padding-left: 1.1rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.76rem;\n}\n.item-table {\n  width: 100%;\n  min-width: 34rem;\n  border-collapse: collapse;\n}\n\n.item-table th,\n.item-table td {\n  padding: 0.55rem;\n  border-bottom: 1px so