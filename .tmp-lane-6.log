ton:hover,\n.vtt-shell button:focus-visible {\n  background: #742c18;\n}\n\n.vtt-shell button[aria-pressed='true'] {\n  outline: 3px solid #e5af4a;\n  outline-offset: 2px;\n}\n\n.vtt-actions {\n  margin-top: 0.8rem;\n}\n\n.vtt-network-note,\n.vtt-fog-warning {\n  max-width: 74ch;\n  color: var(--vtt-muted);\n  font: 0.9rem/1.45 system-ui, sans-serif;\n}\n\n.vtt-status,\n.vtt-role,\n.vtt-error {\n  display: block;\n  margin-top: 0.8rem;\n  font: 650 0.92rem/1.4 system-ui, sans-serif;\n}\n\n.vtt-error {\n  color: #9c1f14;\n}\n\n.vtt-manual textarea {\n  min-height: 6rem;\n  resize: vertical;\n}\n\n.vtt-board-heading {\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n}\n\n.vtt-board-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 800px) minmax(230px, 1fr);\n  gap: 1.2rem;\n  align-items: start;\n  margin-top: 1rem;\n}\n\n.vtt-board-region {\n  overflow: auto;\n  border: 3px solid #342d27;\n  background: #342d27;\n}\n\n.vtt-canvas {\n  display: block;\n  width: 800px;\n  height: 600px;\n  max-width: none;\n  background: var(--vtt-paper);\n  cursor: crosshair;\n  touch-action: none;\n}\n\n.vtt-sidebar {\n  display: grid;\n  gap: 1rem;\n  font-family: system-ui, sans-serif;\n}\n\n.vtt-token-form,\n.vtt-token-editor,\n.vtt-dice-form {\n  display: grid;\n  gap: 0.6rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid var(--vtt-border);\n}\n\n.vtt-token-list,\n.vtt-dice-log {\n  display: grid;\n  gap: 0.45rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.vtt-token-list button {\n  width: 100%;\n  padding-left: 1.8rem;\n  border-color: var(--vtt-border);\n  background:\n    radial-gradient(circle at 0.75rem center, var(--token-color) 0 0.42rem, transparent 0.44rem),\n    #f7f1e7;\n  color: var(--vtt-ink);\n  text-align: left;\n}\n\n.vtt-dice-log li {\n  padding: 0.55rem 0.65rem;\n  border-left: 3px solid var(--vtt-rust);\n  background: #f3ecdf;\n  font-variant-numeric: tabular-nums;\n}\n\n@media (max-width: 1050px) {\n  .vtt-b