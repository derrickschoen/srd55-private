+}
+
+.encounter-cell {
+  position: relative;
+  width: 3rem;
+  height: 3rem;
+  border: 1px solid #31394c;
+  background: #1a1f2c;
+}
+
+.encounter-cell[data-preview='true'] {
+  background: #604d12;
+  box-shadow: inset 0 0 0 2px #f1c75b;
+}
+
+.encounter-token {
