or: #7c1f19;\n  cursor: pointer;\n}\n\n.site-footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem 1.25rem;\n  flex-wrap: wrap;\n  padding: 0.9rem 1rem;\n  border-top: 1px solid #cfc6b6;\n  background: #efe9dc;\n  font-size: 0.8125rem;\n  text-align: center;\n}\n\n.dark .site-footer {\n  border-color: #403a34;\n  background: #12100e;\n}\n\n.site-footer a {\n  color: #6d28d9;\n}\n\n.browser-support-notice {\n  width: min(100%, 72rem);\n  margin: 0 auto;\n  padding: 1rem;\n  border: 0.125rem solid #8c1d18;\n  border-radius: 0.5rem;\n  background: #fff4ef;\n  color: #49110f;\n  text-align: left;\n}\n\n.browser-support-notice h2,\n.browser-support-notice p {\n  margin: 0 0 0.75rem;\n}\n\n.browser-support-notice button {\n  min-height: 2.75rem;\n  padding: 0.55rem 0.9rem;\n  border: 0.125rem solid currentColor;\n  border-radius: 0.35rem;\n  background: #fff;\n  color: #7c1f19;\n  cursor: pointer;\n}\n\n.browser-support-hold {\n  display: grid;\n  min-height: 100vh;\n  place-content: center;\n  gap: 0.75rem;\n  padding: 2rem;\n  text-align: center;\n}\n\n.browser-support-hold h1,\n.browser-support-hold p {\n  margin: 0;\n}\n\n.dark .browser-support-notice {\n  border-color: #ffb4a9;\n  background: #321210;\n  color: #ffe8e4;\n}\n\n.dark .site-footer a {\n  color: #c4b5fd;\n}\n\n.pwa-status {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n}\n\n#persistence-status {\n  color: #62584c;\n}\n\n.dark #persistence-status {\n  color: #cfc6b6;\n}\n\n#update-ready:not([hidden]) {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n#refresh-update {\n  padding: 0;\n  border: 0;\n  color: #6d28d9;\n  background: transparent;\n  text-decoration: underline;\n  cursor: pointer;\n}\n\n.dark #refresh-update {\n  color: #c4b5fd;\n}\n\n@media print {\n  :root {\n    color: #000;\n    background: #fff;\n  }\n\n  /* Printed sheets carry the notice itself, so a link to it is