+}
+
+.encounter-cell[data-preview='true'] {
+  background: #604d12;
+  box-shadow: inset 0 0 0 2px #f1c75b;
+}
+
+.encounter-token {
+  position: absolute;
+  inset: 0.2rem;
+  display: grid;
