   font-family: Georgia, 'Times New Roman', serif;
 }
 
+.encounter-shell {
+  max-width: 78rem;
+  margin: 0 auto;
+  padding: 1.5rem;
+  color: #edf0f7;
+  background: #11131a;
+  min-height: 100vh;
+}
+
+.encounter-board {
+  --encounter-columns: 10;
+  display: grid;
+  grid-template-columns: repeat(var(--encounter-columns), 3rem);
+  width: fit-content;
+  border: 2px solid #78839d;
+  touch-action: none;
+  user-select: none;
+}
+
+.encounter-cell {
+  position: relative;
+  width: 3rem;
+  height: 3rem;
+  border: 1px solid #31394c;
+  background: #1a1f2c;
+}
+
+.encounter-cell[data-preview='true'] {
+  background: #604d12;
+  box-shadow: inset 0 0 0 2px #f1c75b;
+}
+
+.encounter-token {
+  position: absolute;
+  inset: 0.2rem;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  border-radius: 0.45rem;
+  border: 2px solid #8290ad;
+  background: #293249;
+  font-size: 0.62rem;
+  text-align: center;
+}
+
+.encounter-token[data-kind='monster'] {
