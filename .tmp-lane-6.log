s: minmax(12rem, 1fr) minmax(10rem, 12rem);\n  gap: 0.75rem;\n  padding: 0.65rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.4rem;\n}\n\n.source-config-list article div small {\n  margin-top: 0.2rem;\n}\n\n.removable-sources,\n.save-point-list,\n.ceiling-list,\n.invalid-list,\n.operation-list {\n  margin: 0.5rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.removable-sources {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.removable-sources li,\n.save-point-list li {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.6rem;\n  padding: 0.55rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.4rem;\n  font-size: 0.82rem;\n}\n\n.class-list article {\n  grid-template-columns: minmax(7rem, 1fr) auto 6rem minmax(9rem, 1fr) auto;\n}\n\n.class-entry-badge {\n  align-self: center;\n  white-space: nowrap;\n}\n\n.class-prerequisite-warning {\n  grid-column: 1 / -1;\n  padding: 0.65rem;\n  border: 1px solid #b36b00;\n  border-radius: 0.35rem;\n  background: #fff4d6;\n  color: #5f3800;\n}\n\n.class-prerequisite-warning p {\n  margin: 0.3rem 0 0;\n}\n\n.class-add {\n  display: flex;\n  gap: 0.55rem;\n  margin-top: 0.75rem;\n}\n\n.class-add select {\n  max-width: 18rem;\n}\n\n.empty-callout,\n.empty-cell {\n  padding: 2rem;\n  border: 1px dashed #aaa296;\n  border-radius: 0.35rem;\n  color: var(--planner-ink-soft);\n  text-align: center;\n}\n\n.planner-grid-panel {\n  padding: 0;\n  overflow: hidden;\n}\n\n.grid-heading {\n  padding: 1rem;\n  border-bottom: 1px solid var(--planner-border);\n}\n\n.grid-filters {\n  display: grid;\n  margin-top: 0.8rem;\n  grid-template-columns: repeat(4, minmax(9rem, 1fr));\n  gap: 0.55rem;\n}\n\n.grid-count,\n.muted {\n  margin: 0.65rem 0 0;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n}\n\n.grid-scroll {\n  min-width: 0;\n  width: 100%;\n  max-width: 100%;\n  overflow-x: auto;\n}\n\n.planner-table-scroll {\n  min-width: 0;\n  width: 100%;\n  max-width: 100%;\n  overflow-x: auto;\n}\n\n.planner-grid {\n  width: 100%;\n  min-width: 80rem;\n  border-collapse: collapse;\n  font-size: 0.78rem;\n}\n\n.planner-grid th,\n.planner-grid td {\n  padding: 0.55rem 0.6rem;\n  border-bottom: 1px solid var(--planner-border);\n  text-align: left;\n  vertical-align: top;\n}\n\n.planner-grid th {\n  position: sticky;\n  z-index: 2;\n  top: 0;\n  color: #524b42;\n  background: #eee9e0;\n  white-space: nowrap;\n}\n\n.planner-grid th button {\n  padding: 0;\n  border: 0;\n  font-weight: 800;\n  background: transparent;\n}\n\n.slot-attention {\n  background: #fff7df;\n}\n\n.slot-attention-detail td {\n  border-bottom-color: #d9b55d;\n}\n\n.slot-attention-detail p {\n  display: inline-block;\n  max-width: 38rem;\n  margin: 0 0.6rem 0 0;\n}\n\n.slot-attention-detail input {\n  display: inline-block;\n  max-width: 15rem;\n  margin: 0 0.35rem;\n}\n\n.placeholder-badge {\n  display: inline-block;\n  margin: 0.3rem 0 0 0.35rem;\n  border: 1px solid #b7791f;\n  border-radius: 999px;\n  padding: 0.12rem 0.4rem;\n  color: #744210;\n  background: #fff3c4;\n  font-size: 0.68rem;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.spell-picker {\n  position: relative;\n  display: inline-block;\n  min-width: 12rem;\n}\n\n.spell-options {\n  position: absolute;\n  z-index: 30;\n  top: calc(100% + 0.25rem);\n  left: 0;\n  width: min(24rem, 80vw);\n  max-height: 17rem;\n  padding: 0.25rem;\n  overflow: auto;\n  border: 1px solid #aaa296;\n  border-radius: 0.4rem;\n  background: #fff;\n  box-shadow: 0 0.5rem 1.3rem rgb(41 34 26 / 20%);\n}\n\n.spell-option {\n  display: grid;\n  width: 100%;\n  gap: 0.15rem;\n  padding: 0.55rem;\n  border: 0;\n  border-radius: 0.25rem;\n  text-align: left;\n  background: transparent;\n}\n\n.spell-option small {\n  color: var(--planner-ink-soft);\n}\n\n.spell-option:hover,\n.spell-option.is-active {\n  background: #f0e7ff;\n}\n\n.spell-options-status {\n  margin: 0;\n  padding: 0.55rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.75rem;\n}\n\n.save-point-form {\n  display: flex;\n  align-items: end;\n  gap: 0.55rem;\n  margin-top: 0.8rem;\n}\n\n.save-point-form label {\n  flex: 1;\n}\n\n.save-point-list li {\n  border-width: 0 0 1px;\n  border-radius: 0;\n}\n\n.operation-list li {\n  padding: 0.35rem 0;\n  font-size: 0.75rem;\n}\n\n.report-metrics,\n.dice-metrics {\n  display: grid;\n  margin: 0.8rem 0 0;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.45rem;\n}\n\n.report-metrics div,\n.dice-metrics div {\n  padding: 0.65rem;\n  border-radius: 0.4rem;\n  background: #eee9e0;\n}\n\n.report-metrics dt,\n.dice-metrics dt {\n  color: var(--planner-ink-soft);\n  font-size: 0.68rem;\n}\n\n.report-metrics dd,\n.dice-metrics dd {\n  margin: 0.15rem 0 0;\n  font-size: 1.15rem;\n  font-weight: 800;\n}\n\n.slot-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n  margin-top: 0.7rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.8rem;\n}\n\n.pact-magic {\n  margin: 0.65rem 0 0;\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.wizard-explanation {\n  color: var(--planner-ink-soft);\n  font-size: 0.76rem;\n  line-height: 1.45;\n}\n\n.wizard-states {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.wizard-states h3 {\n  margin-bottom: 0.3rem;\n  font-size: 0.74rem;\n}\n\n.wizard-states ul {\n  padding-left: 1rem;\n  margin: 0;\n  font-size: 0.72rem;\n}\n\n.ceiling-list li,\n.invalid-list li {\n  padding: 0.45rem 0;\n  border-bottom: 1px solid var(--planner-border);\n  font-size: 0.8rem;\n}\n\n.invalid-list small {\n  margin-top: 0.25rem;\n}\n\n.report-callout {\n  padding: 0.65rem;\n  border: 1px solid #8cbac8;\n  border-radius: 0.4rem;\n  color: #174a59;\n  background: #e9f7fa;\n  font-size: 0.76rem;\n  line-height: 1.45;\n}\n\n.warning-card {\n  margin-top: 0.55rem;\n  padding: 0.65rem;\n  border: 1px solid #d9b55d;\n  border-radius: 0.4rem;\n  background: #fff7df;\n  font-size: 0.78rem;\n}\n\n.warning-card h4,\n.warning-card p {\n  margin: 0 0 0.35rem;\n}\n\n.acknowledged {\n  margin-top: 0.55rem !important;\n  padding: 0.45rem;\n  border: 1px solid #d9b55d;\n}\n\n.acknowledgement-form {\n  display: flex;\n  gap: 0.4rem;\n  margin-top: 0.55rem;\n}\n\n.dice-helper {\n  border-color: #a98bc7;\n}\n\n.dice-controls {\n  display: grid;\n  margin-top: 0.8rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.55rem;\n}\n\n.dice-profile-field {\n  grid-column: span 2;\n}\n\n.dice-profile-controls {\n  display: grid;\n  margin-top: 0.55rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.55rem;\n}\n\n.dice-profile-controls [hidden] {\n  display: none !important;\n}\n\n.dice-selected-source,\n.dice-field-note {\n  display: block;\n  margin-top: 0.25rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.68rem;\n  font-weight: 500;\n  text-transform: none;\n}\n\n.dice-effects {\n  display: grid;\n  margin-top: 0.8rem;\n  padding: 0.65rem;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.55rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.4rem;\n  font-size: 0.78rem;\n}\n\n.dice-actions {\n  margin-top: 0.7rem;\n}\n\n.dice-actions label {\n  flex: 1;\n}\n\n.dice-roll-result {\n  display: block;\n  margin-top: 0.7rem;\n  padding: 0.65rem;\n  border-radius: 0.4rem;\n  color: #442369;\n  background: #f0e7ff;\n  font-weight: 700;\n}\n\n.dice-roll-result h3 {\n  display: inline;\n  margin-right: 0.65rem;\n}\n\n.dice-roll-result code {\n  font-size: 0.72rem;\n}\n\n.dice-trace {\n  display: grid;\n  padding: 0;\n  margin: 0.65rem 0 0;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n  list-style: none;\n}\n\n.dice-trace li {\n  padding: 0.55rem;\n  border: 1px solid #c4a7df;\n  border-radius: 0.35rem;\n  background: var(--planner-panel);\n  font-size: 0.75rem;\n}\n\n.dice-trace p,\n.dice-stop,\n.dice-profile-note,\n.dice-assumptions p {\n  margin: 0.35rem 0 0;\n  font-size: 0.72rem;\n  font-weight: 500;\n}\n\n.dice-profile-note {\n  padding: 0.55rem;\n  border-radius: 0.35rem;\n  background: #eee9e0;\n}\n\n.dice-profile-note:empty {\n  display: none;\n}\n\n.dice-assumptions {\n  margin-top: 0.75rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.75rem;\n}\n\n@media (max-width: 70rem) {\n  .planner-layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .planner-sidebar {\n    position: static;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .source-add-form {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 48rem) {\n  .planner-header {\n    position: static;\n    align-items: flex-start;\n  }\n\n  .planner-header-actions {\n    flex-direction: column;\n    align-items: flex-end;\n  }\n\n  .planner-header output {\n    font-size: 0.7rem;\n  }\n\n  .ability-grid,\n  .grid-filters,\n  .dice-controls,\n  .dice-profile-controls,\n  .dice-effects,\n  .planner-sidebar,\n  .removable-sources {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .source-config-list article,\n  .class-list article {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .planner-grid {\n    min-width: 0;\n  }\n\n  .planner-grid thead {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n  }\n\n  .planner-grid tbody,\n  .planner-grid tr,\n  .planner-grid td {\n    display: block;\n  }\n\n  .planner-grid tr {\n    margin: 0.65rem;\n    padding: 0.45rem;\n    border: 1px solid var(--planner-border);\n    border-radius: 0.45rem;\n  }\n\n  .planner-grid td {\n    padding: 0.35rem;\n    border: 0;\n  }\n\n  .planner-grid td:nth-child(1) {\n    font-weight: 800;\n  }\n\n  .slot-attention-detail {\n    margin-top: -0.65rem !important;\n  }\n}\n\n@media (max-width: 34rem) {\n  .ability-grid,\n  .grid-filters,\n  .dice-controls,\n  .dice-profile-controls,\n  .dice-effects,\n  .planner-sidebar,\n  .source-add-form {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .planner-header-actions output {\n    display: none;\n  }\n\n  .save-point-form,\n  .acknowledgement-form,\n  .dice-actions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .planner-layout {\n    gap: 1rem;\n    padding: 0.75rem 0.5rem 2rem;\n  }\n\n  .planner-header {\n    flex-wrap: wrap;\n    padding: 0.75rem 0.5rem;\n  }\n\n  .planner-panel {\n    padding: 0.75rem;\n  }\n\n  .multiclass-skill-form {\n    align-items: stretch;\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .panel-heading,\n  .class-add,\n  .weapon-form-controls {\n    align-items: stretch;\n    flex-direction: column;\n  }\n}\n\n@media screen {\n  .planner-shell,\n  .planner-header,\n  .planner-header > *,\n  .planner-layout,\n  .planner-primary,\n  .planner-sidebar,\n  .planner-error,\n  .placeholder-banner,\n  .planner-preview-warning,\n  .planner-panel,\n  .planner-panel > *,\n  .planner-panel details {\n    min-width: 0;\n  }\n\n  .planner-header h1,\n  .planner-error,\n  .placeholder-banner,\n  .planner-preview-warning,\n  .planner-panel :is(h2, h3, h4, h5, p, li, label, summary, dt, dd) {\n    overflow-wrap: anywhere;\n  }\n\n  .planner-panel :is(input, select, textarea, button) {\n    max-width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n.outstanding-list {\n  margin: 0.65rem 0 0;\n  padding-left: 1.25rem;\n  display: grid;\n  gap: 0.6rem;\n}\n\n.outstanding-list h3 {\n  margin: 0;\n  font-size: 0.9rem;\n}\n\n.outstanding-list p {\n  margin: 0.2rem 0 0;\n  font-size: 0.8rem;\n}\n\n.outstanding-remedy {\n  color: var(--planner-ink-soft);\n}\n\n.outstanding-panel h2 + h2 {\n  margin-top: 1rem;\n}\n\n/*\n * Free text of unverified origin (D4 / share-link boundary). The marker is a\n * border, never colour alone, and it never hides or truncates the text — the\n * value stays fully readable and selectable exactly as it is stored.\n */\n.free-text {\n  border-bottom: 1px dotted var(--planner-accent);\n}\n\n.spell-picker-input[data-free-text] {\n  border-bottom-style: dotted;\n}\n\n/*\n * The build reference. Collapsed by default, never hidden: no display:none, no\n * off-screen positioning, no zero opacity. Expanding a section reveals exactly\n * the facts the JSON block carries.\n */\n.build-reference-panel .reference-section {\n  min-width: 0;\n  max-width: 100%;\n  margin-top: 0.6rem;\n  padding: 0.4rem 0.6rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.4rem;\n}\n\n.build-reference-panel summary {\n  cursor: pointer;\n  font-weight: 700;\n}\n\n.build-reference-panel .reference-note {\n  margin: 0.5rem 0 0;\n  color: var(--planner-ink-soft);\n  font-size: 0.8rem;\n}\n\n.build-reference-panel .reference-scroll {\n  min-width: 0;\n  width: 100%;\n  max-width: 100%;\n  overflow-x: auto;\n  margin-top: 0.6rem;\n}\n\n.build-reference-panel .reference-table {\n  width: max-content;\n  min-width: 100%;\n  border-collapse: collapse;\n  font-size: 0.78rem;\n}\n\n.build-reference-panel .reference-table caption {\n  padding-bottom: 0.25rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n  text-align: left;\n}\n\n.build-reference-panel .reference-table th,\n.build-reference-panel .reference-table td {\n  padding: 0.25rem 0.5rem;\n  border-bottom: 1px solid var(--planner-border);\n  text-align: left;\n  vertical-align: top;\n  white-space: nowrap;\n}\n\n/* --- weapons ------------------------------------------------------------- */\n\n.weapon-mastery-status p {\n  margin: 0 0 0.4rem;\n}\n\n.weapon-mastery-warning {\n  color: var(--planner-accent);\n  font-weight: 600;\n}\n\n.weapon-table {\n  width: 100%;\n  min-width: 42rem;\n  border-collapse: collapse;\n  margin-bottom: 0.75rem;\n  font-size: 0.86rem;\n}\n\n.weapon-table caption {\n  margin-bottom: 0.35rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n  text-align: left;\n}\n\n.weapon-table th,\n.weapon-table td {\n  padding: 0.35rem 0.5rem;\n  border-bottom: 1px solid var(--planner-border);\n  text-align: left;\n  vertical-align: top;\n}\n\n.weapon-table td button + button {\n  margin-left: 0.35rem;\n}\n\n.weapon-form fieldset {\n  padding: 0.75rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.35rem;\n}\n\n.weapon-form-fields {\n  display: grid;\n  gap: 0.5rem 0.9rem;\n  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));\n}\n\n.weapon-toggles {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem 0.9rem;\n  grid-column: 1 / -1;\n}\n\n.weapon-toggles label {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n}\n\n.weapon-form-controls {\n  display: flex;\n  gap: 0.5rem;\n  margin-top: 0.75rem;\n}\n\n.weapon-form-error {\n  margin: 0.5rem 0 0;\n  color: var(--planner-accent);\n}\n\n/* --- attack profiles ------------------------------------------------------ */\n\n.attack-profiles {\n  margin-top: 1rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--planner-border);\n}\n\n.attack-profiles h3 {\n  margin: 0 0 0.35rem;\n  font-size: 0.95rem;\n}\n\n.attack-profiles > p {\n  margin: 0 0 0.6rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.84rem;\n}\n\n.attack-profile-warning {\n  color: var(--planner-accent);\n  font-weight: 600;\n}\n\n.attack-weapon {\n  margin-bottom: 0.85rem;\n  padding: 0.55rem 0.7rem;\n  border: 1px solid var(--planner-border);\n  border-radius: 0.35rem;\n}\n\n.attack-weapon h4 {\n  margin: 0 0 0.3rem;\n  font-size: 0.9rem;\n}\n\n.attack-weapon-derived {\n  margin: 0 0 0.5rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n}\n\n.attack-profile + .attack-profile {\n  margin-top: 0.7rem;\n  padding-top: 0.7rem;\n  border-top: 1px dashed var(--planner-border);\n}\n\n.attack-profile h5 {\n  margin: 0 0 0.3rem;\n  font-size: 0.84rem;\n}\n\n.attack-profile select {\n  margin-bottom: 0.35rem;\n}\n\n.attack-profile-numbers {\n  margin: 0 0 0.3rem;\n  font-weight: 600;\n  font-size: 0.88rem;\n}\n\n.attack-profile-reason,\n.attack-profile-count {\n  margin: 0 0 0.25rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.78rem;\n}\n\n.attack-profile-conditions,\n.attack-profile-notes,\n.attack-profile-unresolved {\n  margin: 0.25rem 0 0;\n  padding-left: 1.1rem;\n  color: var(--planner-ink-soft);\n  font-size: 0.76rem;\n}\n.item-table {\n  width: 100%;\n  min-width: 34rem;\n  border-collapse: collapse;\n}\n\n.item-table th,\n.item-table td {\n  padding: 0.55rem;\n  border-bottom: 1px solid var(--border-color, #d7d1c4);\n  text-align: left;\n}\n\n.attunement-replace-modal {\n  position: fixed;\n  inset: 50% auto auto 50%;\n  transform: translate(-50%, -50%);\n  max-width: min(32rem, calc(100vw - 2rem));\n  padding: 1.25rem;\n  border: 1px solid var(--border-color, #756f63);\n  border-radius: 0.5rem;\n  background: var(--surface, #fff);\n  box-shadow: 0 1rem 3rem rgb(0 0 0 / 30%);\n  z-index: 20;\n}\n\n.attunement-replace-choices {\n  display: grid;\n  gap: 0.5rem;\n  margin-block: 1rem;\n}\n"],["STYLE",{},"/*\n * The sheet is plain and labelled on purpose (D4): one number per row, its\n * label beside it, its formula under it. Nothing here hides anything — there is\n * no `display: none`, no zero opacity and no off-screen positioning, because a\n * page whose structured block says more than its visible text is the injection\n * shape that rule exists to refuse.\n */\n.sheet-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: 1.5rem 1rem 3rem;\n}\n\n.sheet-header h1 {\n  margin: 0.75rem 0 0.25rem;\n}\n\n.sheet-print-options {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0;\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.35rem;\n  padding: 0.5rem 0.75rem;\n}\n\n.sheet-print-options legend {\n  font-weight: 600;\n  padding: 0 0.25rem;\n}\n\n.sheet-flavor-value {\n  white-space: pre-wrap;\n}\n\n.sheet-flavor-continuation {\n  display: block;\n  margin-top: 0.35rem;\n  font-style: italic;\n  font-weight: 600;\n}\n\n.sheet-panel {\n  border: 1px solid var(--border, #c9c9c9);\n  border-radius: 0.5rem;\n  padding: 1rem;\n}\n\n.sheet-panel > h2 {\n  margin-top: 0;\n}\n\n.sheet-numbers {\n  display: grid;\n  grid-template-columns: minmax(10rem, 1fr) 2fr;\n  gap: 0.5rem 1rem;\n  margin: 0;\n}\n\n.sheet-number {\n  display: contents;\n}\n\n.sheet-numbers dt {\n  font-weight: 600;\n}\n\n.sheet-numbers dd {\n  margin: 0;\n}\n\n.sheet-figure {\n  font-variant-numeric: tabular-nums;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.sheet-resource-track {\n  display: inline-flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem;\n  margin-left: 0.65rem;\n  vertical-align: middle;\n}\n\n.sheet-resource-box {\n  width: 1rem;\n  height: 1rem;\n  box-sizing: border-box;\n  border: 1px solid currentColor;\n  background: #fff;\n}\n\n.sheet-resource-remaining {\n  font-weight: 600;\n}\n\n.sheet-resource-remaining-line {\n  width: 4rem;\n  height: 1em;\n  border-bottom: 1px solid currentColor;\n}\n\n.sheet-formula {\n  margin: 0.15rem 0 0;\n  font-size: 0.85rem;\n  opacity: 0.8;\n}\n\n.sheet-spell-group + .sheet-spell-group {\n  margin-top: 1rem;\n}\n\n.sheet-spell-group-heading {\n  margin: 0 0 0.5rem;\n  font-size: 1.05rem;\n}\n\n.sheet-spell-statistics {\n  margin-bottom: 0.65rem;\n}\n\n.sheet-spell-statistics p {\n  margin: 0.15rem 0;\n}\n\n.sheet-spell-statistics-label {\n  font-weight: 600;\n}\n\n.sheet-spellbook {\n  padding-top: 0.65rem;\n  margin-top: 0.65rem;\n  border-top: 1px solid var(--border, #c9c9c9);\n}\n\n.sheet-note,\n.sheet-total {\n  font-size: 0.9rem;\n}\n\n.sheet-gaps dt {\n  font-weight: 600;\n  margin-top: 0.5rem;\n}\n\n.sheet-gaps dd {\n  margin: 0.15rem 0 0;\n  font-size: 0.9rem;\n}\n\n#character-sheet-facts {\n  display: block;\n  white-space: pre-wrap;\n  font-family: ui-monospace, monospace;\n  font-size: 0.75rem;\n  max-height: 24rem;\n  overflow: auto;\n  border: 1px dashed var(--border, #c9c9c9);\n  padding: 0.5rem;\n}\n\n@media screen {\n  .sheet-shell,\n  .sheet-header,\n  .sheet-panel,\n  .sheet-number,\n  .sheet-numbers dt,\n  .sheet-numbers dd {\n    min-width: 0;\n  }\n\n  .sheet-header {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(14rem, 1fr));\n    gap: 0.65rem;\n  }\n\n  .sheet-header h1 {\n    grid-column: 1 / -1;\n    overflow-wrap: anywhere;\n  }\n\n  .sheet-print-options {\n    grid-column: 1 / -1;\n  }\n\n  .sheet-panel :is(h2, p, li, dt, dd) {\n    overflow-wrap: anywhere;\n  }\n}\n\n@media screen and (max-width: 34rem) {\n  .sheet-shell {\n    gap: 1rem;\n    padding: 0.75rem 0.5rem 2rem;\n  }\n\n  .sheet-header {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .sheet-header h1 {\n    grid-column: auto;\n    font-size: clamp(1.5rem, 8vw, 2rem);\n  }\n\n  .sheet-header .sheet-chrome {\n    width: 100%;\n    max-width: 100%;\n  }\n\n  .sheet-panel {\n    padding: 0.75rem;\n  }\n\n  #character-sheet-facts {\n    max-width: 100%;\n  }\n}\n\n@media (max-width: 40rem) {\n  .sheet-numbers {\n    grid-template-columns: 1fr;\n  }\n\n  .sheet-number {\n    display: block;\n    border-bottom: 1px solid var(--border, #e3e3e3);\n    padding-bottom: 0.4rem;\n  }\n\n}\n\n@page {\n  size: letter;\n  margin: 0.5in;\n}\n\n/**\n * D89: the v1 paper sheet is this route, reflowed into one column. Disclosures\n * remain inline and D95 warnings retain the same readable size; only\n * interactive chrome is suppressed.\n */\n@media print {\n  .sheet-shell {\n    display: block;\n    max-width: none;\n    margin: 0;\n    padding: 0;\n  }\n\n  .sheet-shell > * + * {\n    margin-top: 1rem;\n  }\n\n  .sheet-shell :is(.sheet-chrome, button, nav, [data-router-link]) {\n    display: none;\n  }\n\n  .sheet-header h1 {\n    margin: 0;\n  }\n\n  .sheet-panel {\n    border-color: #777;\n    border-radius: 0;\n    break-inside: auto;\n  }\n\n  .sheet-panel > h2 {\n    break-after: avoid;\n  }\n\n  .sheet-print-appendix {\n    break-before: page;\n  }\n\n  .sheet-print-appendix :is(h2, h3, h4) {\n    break-after: avoid;\n  }\n\n  .sheet-spell-appendix-summary {\n    break-inside: avoid;\n  }\n\n  .sheet-spell-appendix-card {\n    break-inside: avoid;\n  }\n\n  .sheet-spell-appendix-card[data-spell-appendix-pagination='split_prose'] {\n    break-inside: auto;\n  }\n\n  .sheet-spell-appendix-facts {\n    margin: 0.25rem 0;\n  }\n\n  .sheet-spell-appendix-facts > div {\n    display: grid;\n    grid-template-columns: max-content minmax(0, 1fr);\n    gap: 0.5rem;\n  }\n\n  .sheet-spell-appendix-facts dd {\n    margin: 0;\n  }\n\n  .sheet-print-appendix-prose {\n    break-inside: auto;\n    orphans: 3;\n    widows: 3;\n  }\n\n  .sheet-spell-appendix-prose {\n    white-space: pre-wrap;\n  }\n\n  .sheet-warnings {\n    font-size: 1rem;\n  }\n\n  .sheet-numbers {\n    grid-template-columns: 1fr;\n  }\n\n  .sheet-number {\n    display: block;\n    break-inside: avoid;\n  }\n\n  .sheet-resource-track {\n    break-inside: avoid;\n    color: #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  .sheet-spellbook {\n    border-top-color: #000;\n  }\n\n  .sheet-resource-box {\n    width: 0.2in;\n    height: 0.2in;\n    border: 1.5px solid #000;\n    background: #fff;\n  }\n\n  .sheet-resource-remaining-line {\n    width: 0.8in;\n    border-bottom: 1.5px solid #000;\n  }\n\n  .sheet-number + .sheet-number {\n    margin-top: 0.6rem;\n  }\n\n  .sheet-print-current-hp {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.45rem;\n    margin-left: 2rem;\n    font-weight: 600;\n  }\n\n  .sheet-print-entry {\n    display: inline-block;\n  }\n\n  .sheet-print-entry-box {\n    width: 3.5rem;\n    height: 2.25rem;\n    border: 2px solid #000;\n    vertical-align: middle;\n  }\n\n  .sheet-print-xp {\n    display: grid;\n    grid-template-columns: max-content minmax(8rem, 1fr);\n    align-items: end;\n    gap: 0.75rem;\n  }\n\n  .sheet-print-entry-line {\n    width: 100%;\n    min-width: 8rem;\n    height: 1.35rem;\n    border-bottom: 1px solid #000;\n  }\n\n  .sheet-print-notice {\n    break-before: page;\n    font-size: 0.8rem;\n  }\n}\n"],["STYLE",{},".vtt-shell {\n  --vtt-ink: #211d19;\n  --vtt-muted: #655d53;\n  --vtt-paper: #f4efe4;\n  --vtt-rust: #9c3f25;\n  --vtt-border: #c8bdab;\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 2rem clamp(1rem, 3vw, 3rem) 4rem;\n  color: var(--vtt-ink);\n  font-family: Georgia, 'Times New Roman', serif;\n}\n\n.encounter-shell {\n  max-width: 78rem;\n  margin: 0 auto;\n  padding: 1.5rem;\n  color: #edf0f7;\n  background: #11131a;\n  min-height: 100vh;\n}\n\n.encounter-board {\n  --encounter-columns: 10;\n  display: grid;\n  grid-template-columns: repeat(var(--encounter-columns), 3rem);\n  width: fit-content;\n  border: 2px solid #78839d;\n  touch-action: none;\n  user-select: none;\n}\n\n.encounter-cell {\n  position: relative;\n  width: 3rem;\n  height: 3rem;\n  border: 1px solid #31394c;\n  background: #1a1f2c;\n}\n\n.encounter-cell[data-preview='true'] {\n  background: #604d12;\n  box-shadow: inset 0 0 0 2px #f1c75b;\n}\n\n.encounter-token {\n  position: absolute;\n  inset: 0.2rem;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  border-radius: 0.45rem;\n  border: 2px solid #8290ad;\n  background: #293249;\n  font-size: 0.62rem;\n  text-align: center;\n}\n\n.encounter-token[data-kind='monster'] {\n  background: #552c35;\n}\n\n.encounter-token[data-active='true'] {\n  border-color: #6ff3a2;\n  box-shadow: 0 0 0 3px #1a8e52;\n}\n\n.encounter-token[data-adjudicated='true'] {\n  border-color: #ffb454;\n  box-shadow: 0 0 0 4px #b34a1c;\n}\n\n.active-pc-panel,\n.encounter-controls,\n.dm-pending-request,\n.dm-adjudication,\n.dm-controller-assignments {\n  margin: 1rem 0;\n  padding: 0.8rem;\n  border: 1px solid #3e4961;\n  background: #171b26;\n}\n\n.encounter-controls button,\n.dm-pending-request button,\n.dm-adjudication button {\n  margin: 