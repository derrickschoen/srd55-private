   font-family: Georgia, 'Times New Roman', serif;
 }
 
+.encounter-shell {
+  max-width: 78rem;
+  margin: 0 auto;
+  padding: 1.5rem;
+  color: #edf0f7;
+  background: #11131a;
+  min-height: 100vh;
+}
+
+.encounter-board {
+  --encounter-columns: 10;
+  display: grid;
+  grid-template-columns: repeat(var(--encounter-columns), 3rem);
+  width: fit-content;
