diff --git a/src/combat/encounter.ts b/src/combat/encounter.ts
index c33c41756908425d96352914aeded7c6654dcef8..5e43b1ca4d8bc4a4d24c8c32e4a764d526652ed9
--- a/src/combat/encounter.ts
