+function clonePackage(): typeof FIRST_SKIRMISH_GENERATED_PACKAGE {
+  return structuredClone(FIRST_SKIRMISH_GENERATED_PACKAGE);
+}
+
+describe('increment 9 generated and approved encounter fixtures', () => {
+  it('rejects every incomplete complete-package section', () => {
