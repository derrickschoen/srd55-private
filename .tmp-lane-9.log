+    status: 'deterministic_pass_calibration_pending',
+    request: value.request.difficulty,
+    deterministic: {
+      partyCount: 3,
+      partyLevels: [7, 7, 7],
+      budgets: { low: 2250, moderate: 3900, high: 5100 },
+      requestedBand: pressureBand(value.request.difficulty.pressure),
+      encounterXp,
+      totalChallengeRating,
+      lazyDeadlyLine: 10,
+      dangerCrossCheck: totalChallengeRating > 10,
+    },
