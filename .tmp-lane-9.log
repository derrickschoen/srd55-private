index 0000000000000000000000000000000000000000..b00d2ceb117d08f63b62effedd3957f48d9efe12
--- /dev/null
+++ b/src/vtt/approved-first-skirmish.ts
@@ -0,0 +1,127 @@
+import { canonicalJson } from '../commands/canonical-json';
+import {
+  approveEncounterPackage,
+  buildEncounterGenerationPrompt,
+  encounterArtFromApprovedFixture,
+  type EncounterGenerationRequest,
