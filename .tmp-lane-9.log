+
+  it('OWN-PROVENANCE-UNTRACKED-MANUAL-PATCH records the field and revalidates the whole package', () => {
+    const revised = manuallyPatchEncounterPackage(FIRST_SKIRMISH_GENERATED_PACKAGE, {
