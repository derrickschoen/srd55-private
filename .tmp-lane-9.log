+    expect(dmCells.flatMap((cell) => cell.layers).filter((layer) => layer.role === 'fog')).toHaveLength(6);
+    expect(playerCells.flatMap((cell) => cell.layers).some((layer) => layer.role === 'fog')).toBe(false);
