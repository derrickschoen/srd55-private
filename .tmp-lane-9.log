+    expect(loaded.bytes).toBe(FIRST_SKIRMISH_APPROVED_FIXTURE_BYTES);
+  });
+
+  it('M60-TACTICS-LEAK-TO-PLAYER-PROJECTION keeps all tactics in the DM projection only', () => {
