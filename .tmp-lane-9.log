+    delete withoutMap.layout.map;
+    expect(() => validateGeneratedEncounterPackage(withoutMap)).toThrow();
+  });
+
+  it('M55-DIFFICULTY-DEFAULTS-MEDIUM refuses a request with no required difficulty before exchange', async () => {
+    let calls = 0;
