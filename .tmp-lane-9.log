+
+const STARTER_STATBLOCKS: ReadonlyMap<
+  string,
+  (typeof STARTER_MONSTER_ROSTER)[number]
+> = new Map(
+  STARTER_MONSTER_ROSTER.map((row) => [row.id, row] as const),
+);
+const REFERENCE_PC_IDS = new Set<string>(REFERENCE_PLAYER_IDS);
