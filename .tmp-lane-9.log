+  difficulty: encounterDifficultyRequestSchema,
+  brief: nonEmptyTextSchema,
+});
+
+const rosterEntrySchema = z.strictObject({
+  combatantId: nonEmptyTextSchema,
+  tokenId: nonEmptyTextSchema,
+  statblockId: nonEmptyTextSchema,
+  role: z.enum([
+    'ambusher',
+    'artillery',
+    'bruiser',
+    'controller',
+    'defender',
+    'leader',
+    'skirmisher',
