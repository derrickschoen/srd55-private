+    })).rejects.toThrow('Private party loading is not implemented in increment 9');
+    expect(calls).toBe(0);
+  });
+
+  it('detects tampered content-addressed fixture approval metadata', () => {
+    const fixture = approveEncounterPackage(
+      FIRST_SKIRMISH_GENERATED_PACKAGE,
+      'owner:second-approval',
