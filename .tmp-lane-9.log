+    expect(calls).toBe(0);
+  });
+
+  it('M58-UNAPPROVED-PACKAGE-PERSISTED refuses candidate bytes before owner approval', () => {
+    const store = new MemoryApprovedEncounterFixtureStore();
+    expect(() => persistApprovedEncounterFixture(
