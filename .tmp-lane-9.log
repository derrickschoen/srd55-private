+import { describe, expect, it } from 'vitest';
+import { canonicalJson } from '../../../src/commands/canonical-json';
+import { projectEncounter } from '../../../src/combat/visibility';
+import { encounterBoardRenderModel } from '../../../src/vtt/encounter-board';
+import {
+  FIRST_SKIRMISH_APPROVED_FIXTURE,
+  FIRST_SKIRMISH_APPROVED_FIXTURE_BYTES,
+  FIRST_SKIRMISH_ART,
+  FIRST_SKIRMISH_GENERATED_PACKAGE,
