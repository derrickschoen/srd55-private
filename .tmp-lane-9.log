+      { combatantId: 'combatant:gate-priest-west', priorities: ['Support the least durable ally using only its decoded statblock.', 'Avoid sharing an area with the other priest.', 'Withdraw when isolated.'] },
+    ],
+  },
+  provenance: {
+    generator: 'codex-dm',
+    model: 'codex-project-supervised',
+    effort: 'binding-increment-9',
+    revisions: [{
+      kind: 'generated',
+      sections: ['roster', 'layout', 'tactics'],
+      sessionId: 'codex:increment-9-approved-fixture',
+      exchangeId: 'exchange:first-skirmish:v1',
+    }],
+  },
+} as const;
+
+export const FIRST_SKIRMISH_APPROVED_FIXTURE = approveEncounterPackage(
+  FIRST_SKIRMISH_GENERATED_PACKAGE,
+  'owner:increment-9-binding-approval',
+);
+
+export const FIRST_SKIRMISH_APPROVED_FIXTURE_BYTES = canonicalJson(
+  FIRST_SKIRMISH_APPROVED_FIXTURE,
+);
+
+export const FIRST_SKIRMISH_ART = encounterArtFromApprovedFixture(
+  FIRST_SKIRMISH_APPROVED_FIXTURE,
+);
