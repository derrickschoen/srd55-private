+  )),
+  input('art.token.monster.hobgoblin-warrior.v1', 'Hobgoblin Warrior silhouette', 'token', 'monster-red', rows(
+    '.......+........', '...##########...', '....########....', '....##o##o##....',
+    '.....######...+.', '...##########.+.', '..####.##.####+.', '...###.##.###.+.',
