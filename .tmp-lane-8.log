@@ -0,0 +1,206 @@
+import { assetId, type AssetId } from './ids';
+
+export const STARTER_ART_GENERATOR_ID = 'starter-pixel-art' as const;
+export const STARTER_ART_GENERATOR_VERSION = '1.0.0' as const;
+export const STARTER_ART_INPUT_SET_ID = 'starter-art-inputs-v1' as const;
+
+export type StarterArtKind =
+  | 'token'
+  | 'map'
+  | 'terrain'
+  | 'fog'
+  | 'focus'
+  | 'event';
+
+export type PixelPalette =
+  | 'pc-blue'
+  | 'monster-red'
+  | 'stone'
+  | 'wood'
+  | 'terrain'
+  | 'hazard'
+  | 'fog'
+  | 'focus'
+  | 'adjudicated';
+
+export interface StarterArtInput {
+  readonly id: AssetId;
+  readonly title: string;
+  readonly kind: StarterArtKind;
+  readonly palette: PixelPalette;
+  /** Sixteen 16-pixel rows: # silhouette, + accent, o highlight, . empty. */
+  readonly pixels: readonly string[];
+}
+
+const rows = (...value: readonly string[]): readonly string[] => {
+  if (value.length !== 16 || value.some((row) => row.length !== 16 || /[^#+o.]/u.test(row))) {
+    throw new Error('Starter-art inputs must be exactly 16×16 and use only #, +, o, and .');
+  }
+  return Object.freeze(value);
+};
+
+function input(
+  id: string,
+  title: string,
+  kind: StarterArtKind,
+  palette: PixelPalette,
+  pixels: readonly string[],
+): StarterArtInput {
+  return Object.freeze({ id: assetId(id), title, kind, palette, pixels });
+}
+
+export const STARTER_ART_INPUTS: readonly StarterArtInput[] = Object.freeze([
+  input('art.token.pc.fighter.v1', 'Fighter silhouette', 'token', 'pc-blue', rows(
+    '................', '......++++......', '.....+####+.....', '.....######.....',
+    '......#oo#......', '....########....', '...###.##.###...', '..+###.##.###...',
+    '..++##.##.##....', '..++########....', '..++..####......', '..++..####......',
+    '......#..#......', '.....##..##.....', '....##....##....', '................',
+  )),
+  input('art.token.pc.cleric.v1', 'Cleric silhouette', 'token', 'pc-blue', rows(
+    '.......+........', '......+++.......', '.......+........', '.....######.....',
+    '.....#o##o#.....', '.....######.....', '....########....', '...###.##.###...',
+    '...##..++..##...', '...##.++++.##...', '...##..++..##...', '....########....',
+    '.....##..##.....', '.....##..##.....', '....##....##....', '................',
+  )),
+  input('art.token.pc.wizard.v1', 'Wizard silhouette', 'token', 'pc-blue', rows(
+    '.......+........', '......+++.......', '.....+++++......', '....+++++++.....',
+    '...+++++++++....', '.....######.....', '.....#o##o#.....', '....########....',
+    '...###.##.###.+.', '...##..##..##.++', '...##.++++.##.+.', '....########..+.',
+    '.....##..##...+.', '.....##..##...+.', '....##....##..+.', '................',
+  )),
+  input('art.token.pc.rogue.v1', 'Rogue silhouette', 'token', 'pc-blue', rows(
+    '......####......', '.....######.....', '....########....', '....##o##o##....',
+    '.....######.....', '....########....', '...###.##.###...', '...##..##..##+..',
+    '..+##..##..+++..', '.+++########+...', '..+...####......', '......####......',
+    '.....##..##.....', '....##....##....', '...##......##...', '................',
+  )),
+  input('art.token.monster.goblin-warrior.v1', 'Goblin Warrior silhouette', 'token', 'monster-red', rows(
+    '................', '...##......##...', '..####....####..', '...##########...',
+    '....##o##o##....', '.....######.....', '..+..########...', '.+++.###..###...',
+    '..+..###..###...', '..+...######....', '..+...######....', '.....###.###....',
+    '.....##...##....', '....##.....##...', '...##.......##..', '................',
