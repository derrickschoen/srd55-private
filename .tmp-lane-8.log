+    '....###..###..+.', '....##....##..+.', '...##......##.+.', '................',
+  )),
+  input('art.token.monster.bandit-captain.v1', 'Bandit Captain silhouette', 'token', 'monster-red', rows(
+    '................', '....++++++++....', '..++++++++++++..', '.....######.....',
+    '....##o##o##....', '.....######.....', '...##########...', '..####.##.####..',
+    '.+..##.##.##.+..', '+++..######.+++.', '.+...######..+..', '.....######.....',
+    '.....##..##.....', '....##....##....', '...##......##...', '................',
+  )),
