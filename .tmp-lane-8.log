+    '++..+...+...+..+', '+.+...+...+...++', '+..+...+...+..++', '++..+...+...+..+',
+    '+.+...+...+...++', '+..+...+...+..++', '++..+...+...+..+', '+.+...+...+...++',
+    '+..+...+...+..++', '++..+...+...+..+', '+.+...+...+...++', '++++++++++++++++',
+  )),
+]);
+
+export const STARTER_ART_INPUTS_BY_ID: ReadonlyMap<AssetId, StarterArtInput> =
+  new Map(STARTER_ART_INPUTS.map((entry) => [entry.id, entry] as const));
