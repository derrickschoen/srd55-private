  max-width: 1240px;
  margin: 0 auto;
  padding: 2rem clamp(1rem, 3vw, 3rem) 4rem;
  color: var(--vtt-ink);
  font-family: Georgia, 'Times New Roman', serif;
}

.encounter-shell {
  max-width: 78rem;
