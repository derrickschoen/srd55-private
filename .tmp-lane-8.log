+  z-index: 4;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  overflow: hidden;
+  padding: 0.05rem 0.1rem;
+  background: rgb(8 10 15 / 84%);
+  color: #fff;
+  font: 700 0.48rem/1.1 system-ui, sans-serif;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.encounter-token-focus {
+  z-index: 2;
+  filter: drop-shadow(0 0 2px #58f09a);
 }
 
-.encounter-token[data-adjudicated='true'] {
-  border-color: #ffb454;
-  box-shadow: 0 0 0 4px #b34a1c;
+.encounter-token-adjudicated {
+  z-index: 3;
+  opacity: 0.82;
+  filter: drop-shadow(0 0 2px #ffad42);
 }
 
 .active-pc-panel,
