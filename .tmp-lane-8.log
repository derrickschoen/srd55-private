new file mode 100644
index 0000000000000000000000000000000000000000..6c0c14b37b1e71790df479aba6970d4a227e6b58
--- /dev/null
+++ b//tmp/inc8-assumptions-prompt.txt
@@ -0,0 +1,7 @@
