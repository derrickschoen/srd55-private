+import { z } from 'zod';
+import type { Brand } from '../domain/ids';
+
+export type AssetId = Brand<string, 'AssetId'>;
+
+export const assetIdSchema = z
+  .string()
+  .regex(
+    /^art\.(?:token|map|terrain|fog|focus|event)\.[a-z0-9]+(?:[.-][a-z0-9]+)*\.v\d+$/,
+    'Asset ids must be lowercase, semantic, versioned art ids.',
+  )
+  .brand<'AssetId'>();
+
+export function assetId(value: string): AssetId {
+  return assetIdSchema.parse(value);
+}
diff --git a/src/assets/pixel-art.ts b/src/assets/pixel-art.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0249126ec00818f5c99e58029d5baa18645ad878
--- /dev/null
+++ b/src/assets/pixel-art.ts
@@ -0,0 +1,59 @@
+import type { PixelPalette, StarterArtInput } from './starter-art-inputs';
+
+const PALETTES: Readonly<Record<PixelPalette, Readonly<Record<'background' | '#' | '+' | 'o', string>>>> = {
+  'pc-blue': { background: '#12213a', '#': '#d7e6ff', '+': '#68a7ff', o: '#fff3a8' },
+  'monster-red': { background: '#35151b', '#': '#ffd7cf', '+': '#d95b55', o: '#fff0a8' },
+  stone: { background: '#292d35', '#': '#697382', '+': '#aeb7c2', o: '#eef2f4' },
+  wood: { background: '#2c1c15', '#': '#71442d', '+': '#b87745', o: '#f2d49d' },
+  terrain: { background: '#00000000', '#': '#766d5e', '+': '#b7a88d', o: '#eee3c7' },
+  hazard: { background: '#30131b', '#': '#c73635', '+': '#ffb52e', o: '#fff0a8' },
+  fog: { background: '#10141c', '#': '#202738', '+': '#4a5266', o: '#8790a4' },
+  focus: { background: '#00000000', '#': '#00000000', '+': '#58f09a', o: '#d2ffe3' },
+  adjudicated: { background: '#00000000', '#': '#00000000', '+': '#ffad42', o: '#fff0bd' },
+};
+
+function escapeXml(value: string): string {
+  return value
+    .replaceAll('&', '&amp;')
+    .replaceAll('<', '&lt;')
+    .replaceAll('>', '&gt;')
+    .replaceAll('"', '&quot;')
+    .replaceAll("'", '&apos;');
+}
+
+interface PixelRun {
+  readonly x: number;
+  readonly y: number;
+  readonly width: number;
+  readonly symbol: '#' | '+' | 'o';
+}
+
+function pixelRuns(rows: readonly string[]): readonly PixelRun[] {
+  const runs: PixelRun[] = [];
+  rows.forEach((row, y) => {
+    let x = 0;
+    while (x < row.length) {
+      const symbol = row[x];
+      if (symbol === '.') {
+        x += 1;
+        continue;
+      }
+      if (symbol !== '#' && symbol !== '+' && symbol !== 'o') {
+        throw new Error(`Unknown procedural pixel symbol ${String(symbol)}.`);
+      }
+      let end = x + 1;
+      while (row[end] === symbol) end += 1;
+      runs.push({ x, y, width: end - x, symbol });
+      x = end;
+    }
+  });
+  return runs;
+}
+
+export function renderPixelArtSvg(input: StarterArtInput): string {
+  const palette = PALETTES[input.palette];
+  const rectangles = pixelRuns(input.pixels)
+    .map((run) => `<rect x="${String(run.x)}" y="${String(run.y)}" width="${String(run.width)}" height="1" fill="${palette[run.symbol]}"/>`)
+    .join('');
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="64" height="64" shape-rendering="crispEdges" role="img" aria-label="${escapeXml(input.title)}"><rect width="16" height="16" fill="${palette.background}"/>${rectangles}</svg>\n`;
+}
diff --git a/src/assets/starter-art-inputs.ts b/src/assets/starter-art-inputs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..88e55a43be56724e469e2ffcd4b561b99e97a054
--- /dev/null
+++ b/src/assets/starter-art-inputs.ts
@@ -0,0 +1,206 @@
+import { assetId, type AssetId } from './ids';
+
+export const STARTER_ART_GENERATOR_ID = 'starter-pixel-art' as const;
+export const STARTER_ART_GENERATOR_VERSION = '1.0.0' as const;
+export const STARTER_ART_INPUT_SET_ID = 'starter-art-inputs-v1' as const;
+
+export type StarterArtKind =
+  | 'token'
+  | 'map'
+  | 'terrain'
+  | 'fog'
+  | 'focus'
+  | 'event';
+
+export type PixelPalette =
+  | 'pc-blue'
+  | 'monster-red'
+  | 'stone'
+  | 'wood'
+  | 'terrain'
+  | 'hazard'
+  | 'fog'
+  | 'focus'
+  | 'adjudicated';
+
+export interface StarterArtInput {
+  readonly id: AssetId;
+  readonly title: string;
+  readonly kind: StarterArtKind;
+  readonly palette: PixelPalette;
+  /** Sixteen 16-pixel rows: # silhouette, + accent, o highlight, . empty. */
+  readonly pixels: readonly string[];
+}
+
+const rows = (...value: readonly string[]): readonly string[] => {
+  if (value.length !== 16 || value.some((row) => row.length !== 16 || /[^#+o.]/u.test(row))) {
+    throw new Error('Starter-art inputs must be exactly 16×16 and use only #, +, o, and .');
+  }
+  return Object.freeze(value);
+};
+
+function input(
+  id: string,
+  title: string,
+  kind: StarterArtKind,
+  palette: PixelPalette,
+  pixels: readonly string[],
+): StarterArtInput {
+  return Object.freeze({ id: assetId(id), title, kind, palette, pixels });
+}
+
+export const STARTER_ART_INPUTS: readonly StarterArtInput[] = Object.freeze([
+  input('art.token.pc.fighter.v1', 'Fighter silhouette', 'token', 'pc-blue', rows(
+    '................', '......++++......', '.....+####+.....', '.....######.....',
+    '......#oo#......', '....########....', '...###.##.###...', '..+###.##.###...',
+    '..++##.##.##....', '..++########....', '..++..####......', '..++..####......',
+    '......#..#......', '.....##..##.....', '....##....##....', '................',
+  )),
+  input('art.token.pc.cleric.v1', 'Cleric silhouette', 'token', 'pc-blue', rows(
+    '.......+........', '......+++.......', '.......+........', '.....######.....',
+    '.....#o##o#.....', '.....######.....', '....########....', '...###.##.###...',
+    '...##..++..##...', '...##.++++.##...', '...##..++..##...', '....########....',
+    '.....##..##.....', '.....##..##.....', '....##....##....', '................',
+  )),
+  input('art.token.pc.wizard.v1', 'Wizard silhouette', 'token', 'pc-blue', rows(
+    '.......+........', '......+++.......', '.....+++++......', '....+++++++.....',
+    '...+++++++++....', '.....######.....', '.....#o##o#.....', '....########....',
+    '...###.##.###.+.', '...##..##..##.++', '...##.++++.##.+.', '....########..+.',
+    '.....##..##...+.', '.....##..##...+.', '....##....##..+.', '................',
+  )),
+  input('art.token.pc.rogue.v1', 'Rogue silhouette', 'token', 'pc-blue', rows(
+    '......####......', '.....######.....', '....########....', '....##o##o##....',
+    '.....######.....', '....########....', '...###.##.###...', '...##..##..##+..',
+    '..+##..##..+++..', '.+++########+...', '..+...####......', '......####......',
