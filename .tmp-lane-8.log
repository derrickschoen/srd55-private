    ...base,
    viewer: 'player',
    activeCombatant:
      state.activeCombatant !== null && visibleIds.has(state.activeCombatant)
        ? state.activeCombatant
        : null,
    blockedCells: state.blockedCells
      .filter((cell) => !fog.has(cellKey(cell)))
