+    '##+##+##+##+##+#', '#+##+##+##+##+##', '################', '##+##+##+##+##+#',
+    '#+##+##+##+##+##', '################', '##+##+##+##+##+#', '#+##+##+##+##+##',
+    '################', '##+##+##+##+##+#', '#+##+##+##+##+##', '################',
+  )),
+  input('art.fog.unexplored.v1', 'Unexplored fog', 'fog', 'fog', rows(
+    '################', '################', '##++##++##++##++', '##++##++##++##++',
+    '################', '################', '++##++##++##++##', '++##++##++##++##',
+    '################', '################', '##++##++##++##++', '##++##++##++##++',
+    '################', '################', '++##++##++##++##', '++##++##++##++##',
+  )),
+  input('art.fog.revealed.v1', 'Revealed fog edge', 'fog', 'fog', rows(
+    'o.o.o.o.o.o.o.o.', '................', '................', '................',
+    '................', '................', '................', '................',
+    '................', '................', '................', '................',
+    '................', '................', '................', '.o.o.o.o.o.o.o.o',
+  )),
+  input('art.focus.active-pc.v1', 'Active PC focus ring', 'focus', 'focus', rows(
+    '....++++++++....', '..++........++..', '.+............+.', '.+............+.',
+    '+..............+', '+..............+', '+..............+', '+..............+',
+    '+..............+', '+..............+', '+..............+', '+..............+',
+    '.+............+.', '.+............+.', '..++........++..', '....++++++++....',
+  )),
+  input('art.event.adjudicated.v1', 'ADJUDICATED highlight', 'event', 'adjudicated', rows(
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
+  )),
+]);
+
+export const STARTER_ART_INPUTS_BY_ID: ReadonlyMap<AssetId, StarterArtInput> =
