        id: subject.profile.id,
        name: subject.profile.name,
        kind: subject.profile.kind,
        ...(isViewer ? { hitPoints: subject.hitPoints } : {}),
        life: subject.life,
        position: { ...token.position },
        active: state.activeCombatant === subject.profile.id,
      }];
    },
  );
