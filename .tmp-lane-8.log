+    '+..............+', '+..............+', '+..............+', '+..............+',
+    '.+............+.', '.+............+.', '..++........++..', '....++++++++....',
+  )),
+  input('art.event.adjudicated.v1', 'ADJUDICATED highlight', 'event', 'adjudicated', rows(
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
+    '+...+...+...+...', '.+...+...+...+..', '..+...+...+...+.', '...+...+...+...+',
