+export type StarterArtKind =
+  | 'token'
+  | 'map'
+  | 'terrain'
+  | 'fog'
+  | 'focus'
+  | 'event';
+
+export type PixelPalette =
+  | 'pc-blue'
+  | 'monster-red'
+  | 'stone'
+  | 'wood'
+  | 'terrain'
+  | 'hazard'
+  | 'fog'
+  | 'focus'
