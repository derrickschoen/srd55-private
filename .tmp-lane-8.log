+    generatorVersion: z.literal(STARTER_ART_GENERATOR_VERSION),
+    inputSetId: z.literal(STARTER_ART_INPUT_SET_ID),
+    inputId: assetIdSchema,
+    fixedInputsSha256: sha256Schema,
