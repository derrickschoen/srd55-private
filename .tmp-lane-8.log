+  'art.terrain.rubble.v1': 'a370f67bd4556c619ffa8f3a7bf0211e1bc5326b8106e3855567ac1365912f04',
+  'art.terrain.crate.v1': 'f880dd75b623f48cbd1f420a76ed43769f60f2ced80b6fddedef8c8ce1ccdd79',
+  'art.terrain.pillar.v1': '890d056d9db7c4e473a12c5a9a73f0961cd054ff6a948e6dd8faed8d38eb4be6',
+  'art.terrain.hazard.v1': '0c9f9caab30ff99ed7308598c56f7efa5f958ff1f65a4cd81e13b5955bf20439',
+  'art.fog.hidden.v1': 'cce6585b26d50b6b787de4dd59d11fdc8b4fc5670cc7e889fcbdd20e078b56f5',
+  'art.fog.unexplored.v1': '35a18d5ca8a0907e6006d848564e6959d2e9ab32a89ed189e7d1857e8b076e55',
+  'art.fog.revealed.v1': '32c3ddad76335862f3598c33ff591446a5dac85b16adedeff82d2dc68112313b',
