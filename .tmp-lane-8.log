+
+export const EXPECTED_SPRITE_INVENTORY_SHA256 =
+  'ea0227213db81fe782b2d3e2a44b3af6d5f55d9dad20e3eef32b89ca9b89c776';
+export const EXPECTED_FIXED_INPUTS_SHA256 =
+  'd9cff02ebf9d1b985d223979e0798458c1cde26abf53e4ffafdd2c1a09fdec47';
