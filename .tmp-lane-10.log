+
+export function emptyFleetTelemetry(): FleetTelemetry {
+  return {
+    modelId: null,
+    reasoningEffort: null,
+    buildId: null,
+    commit: null,
+    loadLevelTag: null,
+    latencyMs: null,
+    tokenCounts: null,
