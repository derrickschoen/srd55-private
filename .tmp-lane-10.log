+    commit: process.env.DM_BRIDGE_COMMIT ?? 'unknown-local-commit',
+    loadLevelTag: process.env.DM_BRIDGE_LOAD_LEVEL ?? 'interactive',
+    latencyMs,
+    tokenCounts,
