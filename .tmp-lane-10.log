+    { "mutation": 58, "name": "unapproved_package_persisted", "testFile": "tests/unit/vtt/generated-encounter-fixtures.test.ts", "testName": "M58-UNAPPROVED-PACKAGE-PERSISTED refuses candidate bytes before owner approval" },
+    { "mutation": 59, "name": "approved_fixture_regenerated_on_load", "testFile": "tests/unit/vtt/generated-encounter-fixtures.test.ts", "testName": "M59-APPROVED-FIXTURE-REGENERATED-ON-LOAD never calls generation while loading saved bytes" },
+    { "mutation": 60, "name": "tactics_leak_to_player_projection", "testFile": "tests/unit/vtt/generated-encounter-fixtures.test.ts", "testName": "M60-TACTICS-LEAK-TO-PLAYER-PROJECTION keeps all tactics in the DM projection only" },
+    { "mutation": 61, "name": "telemetry_omits_rng_transition", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M61-TELEMETRY-OMITS-RNG-TRANSITION identifies the first missing RNG post-state" },
+    { "mutation": 62, "name": "controller_response_misattributed", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M62-CONTROLLER-RESPONSE-MISATTRIBUTED rejects a valid response linked to the prior request" },
+    { "mutation": 63, "name": "latency_changes_replay_hash", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M63-LATENCY-CHANGES-REPLAY-HASH keeps clocks outside authoritative replay hashing" },
+    { "mutation": 64, "name": "replay_calls_live_controller", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M64-REPLAY-CALLS-LIVE-CONTROLLER exposes no controller or exchange capability" },
+    { "mutation": 65, "name": "void_branch_replayed_as_live", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M65-VOID-BRANCH-REPLAYED-AS-LIVE refuses a void revision marked active" },
+    { "mutation": 66, "name": "projection_divergence_ignored", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "M66-PROJECTION-DIVERGENCE-IGNORED pinpoints the first bad player projection hash" },
+    { "mutation": "own-1", "name": "token_counts_influence_reducer", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "OWN-TOKEN-COUNTS-CANNOT-INFLUENCE-REDUCER keeps usage out of state and projections" },
+    { "mutation": "own-2", "name": "bundle_version_outside_window_accepted", "testFile": "tests/unit/vtt/replay.test.ts", "testName": "OWN-BUNDLE-VERSION-OUTSIDE-WINDOW is refused while the adjacent migration remains exact" }
+  ]
+}
