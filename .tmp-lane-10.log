    case 'poison_protection':
    case 'ray_enfeeblement':
    case 'rope_trick':
    case 'see_invisibility':
    case 'silence_area':
    case 'spider_climb':
    case 'spiritual_weapon':
    case 'warding_bond':
    case 'truth_zone':
    case 'ongoing_damage':
    case 'summoned_undead':
    case 'beacon_of_hope':
    case 'bestow_curse':
    case 'blink':
    case 'clairvoyance_sensor':
    case 'created_food_and_water':
    case 'daylight_area':
    case 'flight':
    case 'gaseous_form':
    case 'glyph_of_warding':
    case 'haste':
    case 'magic_circle':
    case 'major_image':
    case 'meld_into_stone':
    case 'nondetection':
    case 'phantom_steed':
