+    try {
+      latest = usageCandidate(JSON.parse(line)) ?? latest;
+    } catch {
+      continue;
+    }
+  }
+  return latest ?? { input: 0, cachedInput: 0, output: 0, reasoning: 0 };
+}
+
+function fleetTelemetry(request, latencyMs, tokenCounts) {
