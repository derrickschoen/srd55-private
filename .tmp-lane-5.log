+        0.4821550636552274,
+        0.6149060784373432,
+      ],
+      sameB: [
+        0.027198744006454945,
+        0.4821550636552274,
+        0.6149060784373432,
+      ],
+      different: [
+        0.2938787518069148,
+        0.2561575057916343,
+        0.9031414473429322,
+      ],
