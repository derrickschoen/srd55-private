diff --git a/drizzle/0051_vtt_session_revisions.sql b/drizzle/0051_vtt_session_revisions.sql
new file mode 100644
index 0000000000000000000000000000000000000000..bc4a3ba3846298b422cea207796f809ec7d7b696
--- /dev/null
+++ b/drizzle/0051_vtt_session_revisions.sql
@@ -0,0 +1,20 @@
+CREATE TABLE vtt_session_revisions (
+  session_id VARCHAR NOT NULL,
+  revision integer NOT NULL,
+  schema_version integer NOT NULL,
+  payload_json text NOT NULL,
+  payload_checksum VARCHAR NOT NULL,
+  CONSTRAINT vtt_session_revisions_primary
+    PRIMARY KEY(session_id, revision),
+  CONSTRAINT vtt_session_revisions_session_id_check
+    CHECK(length(session_id) > 0),
+  CONSTRAINT vtt_session_revisions_revision_check
+    CHECK(typeof(revision) = 'integer' AND revision >= 1),
+  CONSTRAINT vtt_session_revisions_schema_version_check
+    CHECK(schema_version IN (1, 2)),
+  CONSTRAINT vtt_session_revisions_payload_json_check
+    CHECK(json_valid(payload_json)),
+  CONSTRAINT vtt_session_revisions_payload_checksum_check
+    CHECK(length(payload_checksum) = 64
+      AND payload_checksum NOT GLOB '*[^0-9a-f]*')
+);
