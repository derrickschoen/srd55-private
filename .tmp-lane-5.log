+    },
+    {
+      snapshot: (): SerializableRngState => ({
+        algorithm: 'mulberry32-v1',
+        initialSeed: state.initialSeed >>> 0,
+        state: current,
+        draws,
+        streamId: state.streamId,
+      }),
+    },
+  );
