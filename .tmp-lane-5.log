+  const normalized = seed >>> 0;
+  return createMulberry32({
+    algorithm: 'mulberry32-v1',
+    initialSeed: normalized,
+    state: normalized,
+    draws: 0,
+    streamId: `seed:${normalized}`,
+  });
+}
