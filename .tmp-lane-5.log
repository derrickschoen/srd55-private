+        encounterSessionId('session:persistence-test'),
+        prefix,
+        new MemoryMirrorSink(),
+      );
+      expect(resumed.rng.snapshot()).toEqual(
+        prefix.revisions(encounterSessionId('session:persistence-test')).at(-1)?.rngState,
