function directCharacterChildTables(db: Database): string[] {
  return db
    .selectValues(
      `SELECT name FROM sqlite_schema
       WHERE type = 'table' AND name NOT LIKE 'sqlite_%'
       ORDER BY name`,
    )
    .map(String)
    .filter((table) =>
      db
        .selectObjects(`PRAGMA foreign_key_list("${table}")`)
        .some((row) => row.table === 'characters'),
    );
}

    ),
  )
  .map((entry) => entry.sql)
  .join('\n');

