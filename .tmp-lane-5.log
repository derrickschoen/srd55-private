index 0000000000000000000000000000000000000000..851ee6dbd197c2fae2e708cf19e2fb66e7127386
--- /dev/null
+++ b/tests/unit/vtt/session-persistence.test.ts
@@ -0,0 +1,485 @@
+import { describe, expect, it } from 'vitest';
+import { canonicalJson } from '../../../src/commands/canonical-json';
+import {
+  AlgorithmController,
+  ControllerRegistry,
+  HumanController,
+  StaleControllerResponseError,
+  type Controller,
+} from '../../../src/combat/controllers';
+import {
+  TurnCoordinator,
+  type PersistedCoordinatorState,
+} from '../../../src/combat/coordinator';
+import { createEncounter } from '../../../src/combat/encounter';
