y must be registered before insert') WHERE NOT EXISTS ( SELECT 1 FROM catalog_content_identities WHERE content_key = NEW.content_key AND content_kind = 'subclass' ); END"},{"type":"trigger","name":"catalog_register_weapon_identity_before_insert","table":"weapon_templates","sql":"CREATE TRIGGER catalog_register_weapon_identity_before_insert BEFORE INSERT ON weapon_templates BEGIN SELECT RAISE(ABORT, 'weapon content key is registered for another kind') WHERE EXISTS ( SELECT 1 FROM catalog_content_identities WHERE content_key = NEW.content_key AND content_kind <> 'weapon' ); SELECT RAISE(ABORT, 'weapon content key must be registered before insert') WHERE NOT EXISTS ( SELECT 1 FROM catalog_content_identities WHERE content_key = NEW.content_key AND content_kind = 'weapon' ); END"},{"type":"trigger","name":"character_items_clear_attunement_slots_before_delete","table":"character_items","sql":"CREATE TRIGGER character_items_clear_attunement_slots_before_delete BEFORE DELETE ON character_items BEGIN UPDATE character_attunement_slots SET slot_1_item_id = CASE WHEN slot_1_item_id = OLD.id THEN NULL ELSE slot_1_item_id END, slot_2_item_id = CASE WHEN slot_2_item_id = OLD.id THEN NULL ELSE slot_2_item_id END, slot_3_item_id = CASE WHEN slot_3_item_id = OLD.id THEN NULL ELSE slot_3_item_id END WHERE character_id = OLD.character_id AND OLD.id IN (slot_1_item_id, slot_2_item_id, slot_3_item_id); END"},{"type":"trigger","name":"character_sources_clear_level_feat_choices_before_delete","table":"character_source_instances","sql":"CREATE TRIGGER character_sources_clear_level_feat_choices_before_delete BEFORE DELETE ON character_source_instances BEGIN UPDATE character_level_feat_choices SET feat_source_instance_id = NULL, updated_at = CURRENT_TIMESTAMP WHERE character_id = OLD.character_id AND feat_source_instance_id = OLD.id; END"},{"type":"trigger","name":"feat_category_preserves_background_default_before_update","table":"feat_definitions","sql":"CREATE TRIGGER feat_category_preserves_background_default_before_update BEFORE UPDATE OF category ON feat_definitions WHEN OLD.category = 'origin' AND NEW.category <> 'origin' BEGIN SELECT RAISE(ABORT, 'referenced background default feat must remain an Origin feat') WHERE EXISTS ( SELECT 1 FROM background_templates WHERE default_origin_feat_content_key = OLD.content_key ); END"},{"type":"trigger","name":"spell_slots_exclusive_assignment_insert","table":"spell_selection_slots","sql":"CREATE TRIGGER spell_slots_exclusive_assignment_insert BEFORE INSERT ON spell_selection_slots WHEN NEW.fixed_spell_version_id IS NOT NULL AND NEW.current_spell_version_id IS NOT NULL BEGIN SELECT RAISE(ABORT, 'a spell slot cannot hold both a fixed grant and a user selection'); END"},{"type":"trigger","name":"spell_slots_exclusive_assignment_update","table":"spell_selection_slots","sql":"CREATE TRIGGER spell_slots_exclusive_assignment_update BEFORE UPDATE ON spell_selection_slots WHEN NEW.fixed_spell_version_id IS NOT NULL AND NEW.current_spell_version_id IS NOT NULL BEGIN SELECT RAISE(ABORT, 'a spell slot cannot hold both a fixed grant and a user selection'); END"}]
