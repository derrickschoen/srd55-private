+      case 'head_moved': {
+        if (parent === null || parent === undefined) {
+          throw new Error('A head move requires a target parent.');
+        }
+        requireCanonicalEqual(
+          revision.encounterState,
+          parent.encounterState,
+          'head-move encounter state',
+        );
