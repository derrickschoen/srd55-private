+    };
+    const opportunityAttack: Extract<
+      EncounterCommand,
+      { readonly type: 'opportunity_attack' }
+    > = {
+      type: 'opportunity_attack',
+      actor: reactor.id,
+      target: mover.id,
+      attackBonus: 100,
+      criticalFloor: 20,
+      rollMode: 'normal',
+      attackerCanSeeTarget: true,
+      targetCanSeeAttacker: true,
+      damage: {
+        terms: [{
