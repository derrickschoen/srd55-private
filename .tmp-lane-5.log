+    const revisions = store.revisions(encounterSessionId('session:persistence-test'));
+    expect(revisions.map((revision) => revision.transition.kind)).toEqual([
+      'session_started',
+      'reducer_applied',
+      'controller_request_issued',
+      'controller_response_received',
