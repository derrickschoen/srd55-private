function update(db: Database, table: string, id: number, values: Values): void {
  const columns = Object.keys(values);
  db.exec({
    sql: `UPDATE "${table}" SET ${columns
      .map((column) => `"${column}" = ?`)
      .join(', ')} WHERE "id" = ?`,
    bind: [...Object.values(values), id],
  });
}

