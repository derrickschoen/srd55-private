+      expect(rows).toEqual([
+        { revision: 1, schema_version: 2 },
+        { revision: 2, schema_version: 2 },
+        { revision: 3, schema_version: 2 },
+        { revision: 4, schema_version: 2 },
+        { revision: 5, schema_version: 2 },
