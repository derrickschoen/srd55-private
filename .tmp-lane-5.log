      expect(db.selectValues(
        `SELECT name FROM sqlite_schema
         WHERE name IN (${indexNames.map(() => '?').join(', ')})`,
        indexNames,
      )).toEqual([]);

      db.exec(RELATIONSHIP_INDEXES_MIGRATION.sql);

      expect(db.selectValues(
        `SELECT name FROM sqlite_schema
         WHERE name IN (${indexNames.map(() => '?').join(', ')})
         ORDER BY name`,
        indexNames,
