+      expect(
+        EncounterSessionJournal.resume(
+          encounterSessionId('session:persistence-test'),
+          store,
+          new MemoryMirrorSink(),
+        ).encounterState,
+      ).toEqual(coordinator.state());
+    } finally {
+      connection.close();
+    }
+  });
+});

