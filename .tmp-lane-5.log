+import { createHash } from 'node:crypto';
+import { createEncounter } from '/home/vagrant/PhpstormProjects/dnd-lane-vtt3a/src/combat/encounter.ts';
+import {
+  monsterProfile,
+  placedToken,
+  playerProfile,
+} from '/home/vagrant/PhpstormProjects/dnd-lane-vtt3a/tests/unit/combat/fixtures.ts';
+
+function stable(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stable).join(',')}]`;
+  const record = value as Readonly<Record<string, unknown>>;
+  return `{${Object.keys(record).sort().map(
+    (key) => `${JSON.stringify(key)}:${stable(record[key])}`,
+  ).join(',')}}`;
+}
+
+function reference(seed: number): readonly number[] {
+  let current = seed >>> 0;
+  return [0, 1, 2].map(() => {
+    current = (current + 0x6d2b79f5) >>> 0;
+    let mixed = Math.imul(current ^ (current >>> 15), 1 | current);
+    mixed = (mixed + Math.imul(mixed ^ (mixed >>> 7), 61 | mixed)) ^ mixed;
+    return ((mixed ^ (mixed >>> 14)) >>> 0) / 4294967296;
+  });
+}
+
+const player = playerProfile('persist-player', { initiativeBonus: 20 });
+const monster = monsterProfile('persist-monster', {
+  initiativeBonus: -20,
+  hitPoints: 20,
+});
+const encounterState = createEncounter({
+  bounds: { columns: 6, rows: 2 },
+  combatants: [player, monster],
+  tokens: [placedToken(player, 0), placedToken(monster, 5)],
+});
+const parentRngState = {
+  algorithm: 'mulberry32-v1',
+  initialSeed: 9182,
+  state: 9182,
+  draws: 0,
+  streamId: 'seed:9182',
+};
+for (const branchId of ['branch:pinned', 'branch:different']) {
+  const material = stable({ encounterState, parentRngState, branchId });
+  const digest = createHash('sha256').update(material).digest('hex');
+  const seed = Number.parseInt(digest.slice(0, 8), 16) >>> 0;
+  process.stdout.write(JSON.stringify({ branchId, digest, seed, values: reference(seed) }) + '\n');
+}
