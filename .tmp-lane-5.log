     FROM catalog_data_migrations`,
  );
}

export function migratedPrefixCharacterRows(
  db: DatabaseContext,
): readonly Record<string, unknown>[] {
  return db.allRaw(
    `SELECT name, notes
     FROM characters
     WHERE name = 'CI-2b prefix fixture'`,
  );
}

