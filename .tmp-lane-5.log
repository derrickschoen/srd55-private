+  const ids = new Set<string>();
+  for (const migration of VTT_SESSION_MIGRATIONS) {
+    if (
+      ids.has(migration.id) ||
+      migration.from !== expected ||
+      migration.to !== expected + 1 ||
+      sha256(migration.source) !== migration.checksum
