+  if (context.state.config.initiativeMode === 'side_alternating') {
+    return enemySlot === null ? playerSlots : [...playerSlots, enemySlot];
+  }
+  return sortInitiativeSlots(enemySlot === null ? playerSlots : [...playerSlots, enemySlot]);
+}
