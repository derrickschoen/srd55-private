+export const INITIATIVE_MODES = [
+  'per_combatant',
+  'shared_enemy',
+  'side_alternating',
+] as const;
+
+export type InitiativeMode = (typeof INITIATIVE_MODES)[number];
+
+export interface EncounterConfig {
