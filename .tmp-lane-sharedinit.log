+  const modes: RollMode[] = ['normal'];
+  for (const clause of conditionMechanicalState(
+    combatantConditions(state, subject.profile.id),
+  ).clauses) {
+    if (clause.kind === 'roll_mode' && clause.roll === 'initiative') modes.push(clause.mode);
