      encounterRevision: state.revision,
      controller: identity,
      requestId: null,
      requestLink: link,
      payload: response,
      fleet,
    });
    journal.record({
      transition: { kind: 'controller_response_received', decision: response },
      encounterState: state,
      coordinatorState: INITIAL_COORDINATOR,
      controllers,
