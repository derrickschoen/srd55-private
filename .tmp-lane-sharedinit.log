+type InitiativeEntryDraft = Omit<InitiativeEntry, 'slot'>;
+
+interface InitiativeSlotDraft {
+  readonly entries: readonly InitiativeEntryDraft[];
+  readonly total: number;
+  readonly bonus: number;
+  readonly tieBreaker: CombatantId;
