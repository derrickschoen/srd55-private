+  const bonus = initiativeBonusFor(context.state, subject);
+  const entry: InitiativeEntryDraft = {
+    combatant: subject.profile.id,
+    total: roll.chosen + bonus,
+    roll: roll.chosen,
+    bonus,
+  };
