34:function dice(
35:  baseCount: number,
36:  sides: number,
37:  options: {
38:    readonly modifier?: number;
39:    readonly perSlotCount?: number;
40:    readonly perSlotModifier?: number;
41:    readonly cantripUpgrade?: boolean;
42:  } = {},
43:): ScaledDice {
44:  return {
45:    baseCount,
46:    sides,
47:    modifier: options.modifier ?? 0,
48:    perSlotCount: options.perSlotCount ?? 0,
49:    perSlotModifier: options.perSlotModifier ?? 0,
50:    cantripUpgrade: options.cantripUpgrade ?? false,
51:  };
52:}
53:
54:function effect(
55:  payload: EffectPayload,
56:  options: {
57:    readonly target?: 'self' | 'targets';
58:    readonly concentration?: boolean;
59:    readonly durationRounds?: number | null;
60:    readonly expiresAt?: EffectData['expiresAt'];
61:    readonly repeatedSave?: EffectData['repeatedSave'];
62:    readonly durationRoundsPerSlot?: number;
63:  } = {},
64:): EffectData {
65:  return {
66:    payload,
67:    target: options.target ?? 'targets',
68:    concentration: options.concentration ?? false,
69:    durationRounds: options.durationRounds ?? 1,
70:    expiresAt: options.expiresAt ?? 'source_start',
71:    ...(options.repeatedSave === undefined ? {} : { repeatedSave: options.repeatedSave }),
72:    ...(options.durationRoundsPerSlot === undefined ? {} : { durationRoundsPerSlot: options.durationRoundsPerSlot }),
73:  };
74:}
