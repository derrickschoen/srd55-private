    source: 'docs/srd/source/spell-descriptions.txt:3520', castingTime: 'action', components: material('a leather strap'),
    targeting: { kind: 'multiple', rangeFeet: 5, baseMaximum: 1, additionalPerSlot: 1, willing: true },
    operation: { kind: 'effect', effect: effect({ kind: 'freedom_of_movement', ignoresDifficultTerrain: true, preventsMagicalSpeedReduction: true, preventedConditions: ['Paralyzed', 'Restrained'], swimSpeedEqualsSpeed: true, nonmagicalEscapeMovementFeet: 5 }, { durationRounds: 600 }) },
  },

