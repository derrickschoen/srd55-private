{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-lane.invalid/schemas/external-party-pack-v2.json",
  "title": "External Party Pack",
  "description": "A public, engine-vocabulary-only party interchange format. It contains no narration, feature prose, or source-product fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "partyId", "allowPartial", "members"],
  "oneOf": [
    {
      "properties": {
        "schemaVersion": { "const": 1 },
        "members": { "items": { "$ref": "#/$defs/memberV1" } }
      }
    },
    {
      "properties": {
        "schemaVersion": { "const": 2 },
        "members": { "items": { "$ref": "#/$defs/memberV2" } }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "partyId": { "type": "string", "pattern": "^party:[a-z0-9][a-z0-9-]{0,79}$" },
    "allowPartial": { "type": "boolean" },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": true
    }
  },
  "$defs": {
    "abilityScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"],
      "properties": {
        "strength": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dexterity": { "type": "integer", "minimum": 1, "maximum": 30 },
        "constitution": { "type": "integer", "minimum": 1, "maximum": 30 },
        "intelligence": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wisdom": { "type": "integer", "minimum": 1, "maximum": 30 },
        "charisma": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "saveBonuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"],
      "properties": {
        "strength": { "type": "integer", "minimum": -30, "maximum": 30 },
        "dexterity": { "type": "integer", "minimum": -30, "maximum": 30 },
        "constitution": { "type": "integer", "minimum": -30, "maximum": 30 },
        "intelligence": { "type": "integer", "minimum": -30, "maximum": 30 },
        "wisdom": { "type": "integer", "minimum": -30, "maximum": 30 },
        "charisma": { "type": "integer", "minimum": -30, "maximum": 30 }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classId", "level"],
      "properties": {
        "classId": {
          "enum": ["Barbarian", "Bard", "Cleric", "Druid", "Fighter", "Monk", "Paladin", "Ranger", "Rogue", "Sorcerer", "Warlock", "Wizard"]
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damageTypeId", "count", "sides", "modifier"],
      "properties": {
        "damageTypeId": {
          "enum": ["Acid", "Bludgeoning", "Cold", "Fire", "Force", "Lightning", "Necrotic", "Piercing", "Poison", "Psychic", "Radiant", "Slashing", "Thunder"]
        },
        "count": { "type": "integer", "minimum": 0, "maximum": 100 },
        "sides": { "enum": [4, 6, 8, 10, 12, 20] },
        "modifier": { "type": "integer", "minimum": -30, "maximum": 30 }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackId", "kind", "attackBonus", "criticalFloor", "reachFeet", "rangeFeet", "damage"],
      "properties": {
        "attackId": { "type": "string", "pattern": "^attack:[a-z0-9][a-z0-9-]{0,79}$" },
        "kind": { "enum": ["melee", "ranged"] },
        "attackBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "criticalFloor": { "type": "integer", "minimum": 2, "maximum": 20 },
        "reachFeet": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "rangeFeet": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "damage": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/damage" } }
      }
    },
    "spellSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "maximum"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "v2SpellSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "count", "recharge"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "count": { "type": "integer", "minimum": 1, "maximum": 99 },
        "recharge": { "const": "long_rest" }
      }
    },
    "resourceSpellUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spellId", "resourcePoolId"],
      "properties": {
        "spellId": { "type": "string" },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" }
      }
    },
    "spellcastingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability", "spellSaveDc", "spellAttackBonus", "preparedSpellIds", "knownSpellIds"],
      "properties": {
        "ability": { "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
        "spellSaveDc": { "type": "integer", "minimum": 1, "maximum": 50 },
        "spellAttackBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "preparedSpellIds": { "type": "array", "maxItems": 175, "items": { "type": "string" } },
        "knownSpellIds": { "type": "array", "maxItems": 175, "items": { "type": "string" } },
        "resourceSpellUses": { "type": "array", "maxItems": 175, "items": { "$ref": "#/$defs/resourceSpellUse" } }
      }
    },
    "legacySpellcasting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability", "spellSaveDc", "spellAttackBonus", "preparedSpellIds", "knownSpellIds", "spellSlots"],
      "properties": {
        "ability": { "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
        "spellSaveDc": { "type": "integer", "minimum": 1, "maximum": 50 },
        "spellAttackBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "preparedSpellIds": { "type": "array", "maxItems": 175, "items": { "type": "string" } },
        "knownSpellIds": { "type": "array", "maxItems": 175, "items": { "type": "string" } },
        "spellSlots": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/v2SpellSlot" } },
        "resourceSpellUses": { "type": "array", "maxItems": 175, "items": { "$ref": "#/$defs/resourceSpellUse" } }
      }
    },
    "pactSpellSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "count", "recharge"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "count": { "type": "integer", "minimum": 1, "maximum": 99 },
        "recharge": { "const": "short_rest" }
      }
    },
    "startingCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectId", "conditionId"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "conditionId": {
          "enum": ["Blinded", "Charmed", "Deafened", "Exhaustion", "Frightened", "Grappled", "Incapacitated", "Invisible", "Paralyzed", "Petrified", "Poisoned", "Prone", "Restrained", "Stunned", "Unconscious"]
        }
      }
    },
    "resourcePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourcePoolId", "maximum", "recharge"],
      "properties": {
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 999 },
        "recharge": { "enum": ["short_rest", "long_rest"] }
      }
    },
    "featureEffect": {
      "oneOf": [
        { "$ref": "#/$defs/damageRiderEffect" },
        { "$ref": "#/$defs/attackRollModifierEffect" },
        { "$ref": "#/$defs/attackRollModeEffect" },
        { "$ref": "#/$defs/armorClassModifierEffect" },
        { "$ref": "#/$defs/savingThrowModifierEffect" },
        { "$ref": "#/$defs/skillModifierEffect" },
        { "$ref": "#/$defs/temporaryHitPointsEffect" },
        { "$ref": "#/$defs/conditionApplicationEffect" },
        { "$ref": "#/$defs/exhaustionApplicationEffect" },
        { "$ref": "#/$defs/movementModifierEffect" }
      ]
    },
    "damageRiderEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "damage"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "damage_rider" },
        "trigger": { "enum": ["on_hit", "on_crit"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "damage": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/damage" } }
      }
    },
    "attackRollModifierEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "count", "sides", "sign"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "attack_roll_modifier" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "sides": { "enum": [4, 6, 8, 10, 12, 20] },
        "sign": { "enum": [-1, 1] }
      }
    },
    "attackRollModeEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "mode"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "attack_roll_mode" },
        "trigger": { "enum": ["action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "mode": { "enum": ["advantage", "disadvantage"] }
      }
    },
    "armorClassModifierEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "amount"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "armor_class_modifier" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "amount": { "type": "integer", "minimum": -30, "maximum": 30 }
      }
    },
    "savingThrowModifierEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "count", "sides", "sign"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "saving_throw_modifier" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "sides": { "enum": [4, 6, 8, 10, 12, 20] },
        "sign": { "enum": [-1, 1] }
      }
    },
    "skillModifierEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "skillId", "count", "sides", "sign"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "skill_modifier" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "skillId": { "enum": ["acrobatics", "animal_handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight_of_hand", "stealth", "survival"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "sides": { "enum": [4, 6, 8, 10, 12, 20] },
        "sign": { "enum": [-1, 1] }
      }
    },
    "temporaryHitPointsEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "amount"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "temporary_hit_points" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "amount": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "conditionApplicationEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "conditionId"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "condition_application" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "conditionId": { "enum": ["Blinded", "Charmed", "Deafened", "Frightened", "Grappled", "Incapacitated", "Invisible", "Paralyzed", "Petrified", "Poisoned", "Prone", "Restrained", "Stunned", "Unconscious"] }
      }
    },
    "exhaustionApplicationEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "level"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "exhaustion_application" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "movementModifierEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "kind", "trigger", "speedDeltaFeet"],
      "properties": {
        "effectId": { "type": "string", "pattern": "^effect:[a-z0-9][a-z0-9:-]{0,119}$" },
        "kind": { "const": "movement_modifier" },
        "trigger": { "enum": ["always_on", "action", "bonus_action", "reaction"] },
        "resourcePoolId": { "type": "string", "pattern": "^resource:[a-z0-9][a-z0-9-]{0,79}$" },
        "speedDeltaFeet": { "type": "integer", "minimum": -30, "maximum": 30 }
      }
    },
    "passives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armorClassBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "initiativeBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "savingThrowBonuses": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "strength": { "type": "integer", "minimum": -30, "maximum": 30 },
            "dexterity": { "type": "integer", "minimum": -30, "maximum": 30 },
            "constitution": { "type": "integer", "minimum": -30, "maximum": 30 },
            "intelligence": { "type": "integer", "minimum": -30, "maximum": 30 },
            "wisdom": { "type": "integer", "minimum": -30, "maximum": 30 },
            "charisma": { "type": "integer", "minimum": -30, "maximum": 30 }
          }
        },
        "skillBonuses": {
          "type": "array", "maxItems": 18,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["skillId", "bonus"],
            "properties": {
              "skillId": { "enum": ["acrobatics", "animal_handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight_of_hand", "stealth", "survival"] },
              "bonus": { "type": "integer", "minimum": -30, "maximum": 30 }
            }
          }
        },
        "speedAdjustmentFeet": { "type": "integer", "minimum": -30, "maximum": 30 },
        "damageResponses": {
          "type": "array", "maxItems": 13,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["damageTypeId", "response"],
            "properties": {
              "damageTypeId": { "enum": ["Acid", "Bludgeoning", "Cold", "Fire", "Force", "Lightning", "Necrotic", "Piercing", "Poison", "Psychic", "Radiant", "Slashing", "Thunder"] },
              "response": { "enum": ["resistant", "vulnerable", "immune"] }
            }
          }
        },
        "conditionImmunities": {
          "type": "array", "maxItems": 15,
          "items": { "enum": ["Blinded", "Charmed", "Deafened", "Exhaustion", "Frightened", "Grappled", "Incapacitated", "Invisible", "Paralyzed", "Petrified", "Poisoned", "Prone", "Restrained", "Stunned", "Unconscious"] }
        }
      }
    },
    "memberV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combatantId", "tokenId", "characterId", "classes", "abilities", "armorClass", "hitPointMaximum", "walkingSpeedFeet", "initiativeBonus", "savingThrowBonuses", "attacksPerAction", "spellSlots", "attacks", "spellSelections", "startingConditions"],
      "properties": {
        "combatantId": { "type": "string", "pattern": "^combatant:[a-z0-9][a-z0-9-]{0,79}$" },
        "tokenId": { "type": "string", "pattern": "^token:[a-z0-9][a-z0-9-]{0,79}$" },
        "characterId": { "type": "integer", "minimum": 1 },
        "classes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/class" } },
        "abilities": { "$ref": "#/$defs/abilityScores" },
        "armorClass": { "type": "integer", "minimum": 1, "maximum": 50 },
        "hitPointMaximum": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "walkingSpeedFeet": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "initiativeBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "savingThrowBonuses": { "$ref": "#/$defs/saveBonuses" },
        "attacksPerAction": { "type": "integer", "minimum": 1, "maximum": 20 },
        "spellSlots": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/spellSlot" } },
        "attacks": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/attack" } },
        "spellSelections": { "type": "array", "items": { "type": "string" } },
        "startingConditions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/startingCondition" } }
      }
    },
    "memberV2": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["spellcasting"],
            "properties": { "spellcasting": { "type": "array" } }
          },
          "then": { "required": ["sharedSpellSlots"] }
        }
      ],
      "required": ["combatantId", "tokenId", "characterId", "classes", "abilities", "armorClass", "hitPointMaximum", "walkingSpeedFeet", "initiativeBonus", "savingThrowBonuses", "attacksPerAction", "attacks", "startingConditions"],
      "properties": {
        "combatantId": { "type": "string", "pattern": "^combatant:[a-z0-9][a-z0-9-]{0,79}$" },
        "tokenId": { "type": "string", "pattern": "^token:[a-z0-9][a-z0-9-]{0,79}$" },
        "characterId": { "type": "integer", "minimum": 1 },
        "classes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/class" } },
        "abilities": { "$ref": "#/$defs/abilityScores" },
        "armorClass": { "type": "integer", "minimum": 1, "maximum": 50 },
        "hitPointMaximum": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "walkingSpeedFeet": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "initiativeBonus": { "type": "integer", "minimum": -30, "maximum": 30 },
        "savingThrowBonuses": { "$ref": "#/$defs/saveBonuses" },
        "attacksPerAction": { "type": "integer", "minimum": 1, "maximum": 20 },
        "attacks": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/attack" } },
        "spellcasting": {
          "oneOf": [
            { "$ref": "#/$defs/legacySpellcasting" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/spellcastingSource" }
            }
          ]
        },
        "sharedSpellSlots": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/v2SpellSlot" } },
        "pactSpellSlots": {
          "description": "Declares a separately recharging Pact Magic pool. The current party-pack loader refuses this field with pact_slots_unmodelled instead of merging it into sharedSpellSlots.",
          "type": "array",
          "maxItems": 9,
          "items": { "$ref": "#/$defs/pactSpellSlot" }
        },
        "startingConditions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/startingCondition" } },
        "effects": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/featureEffect" } },
        "resources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/resourcePool" } },
        "passives": { "$ref": "#/$defs/passives" }
      }
    }
  }
}
