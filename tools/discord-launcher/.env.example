# Copy to .env. Never commit the real file.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: enables the documented PATCH /applications/@me authentication probe.
DISCORD_BOT_TOKEN=

TUNNEL=cloudflared
PORT=5173

# Optional ngrok settings. NGROK_DOMAIN is the account-assigned hostname.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
