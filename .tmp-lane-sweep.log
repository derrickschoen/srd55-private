  readonly movement: DecodedField<readonly MonsterMovementSpeed[]>;
  readonly abilities: DecodedField<Readonly<Record<Ability, MonsterAbilityLine>>>;
  readonly skills: DecodedField<readonly MonsterSkill[]>;
