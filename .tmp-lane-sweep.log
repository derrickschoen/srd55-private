    for (const entry of STARTER_MONSTER_KB) {
      expect(entry.rulingGuidance).not.toContain('\n');
      expect(entry.srdLocator).toMatch(/^docs\/srd\/full\/srd-5\.2\.1\.txt:\d+-\d+$/);
    }
  });
