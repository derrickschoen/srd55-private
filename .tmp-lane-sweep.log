+const warhorseSkeletonAbilities = abilityLines([18, 4, 4], [12, 1, 1], [15, 2, 2], [2, -4, -4], [8, -1, -1], [5, -3, -3]);
+export const WARHORSE_SKELETON = monsterStatblock({
