{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/simulation/coverage.ts:1025-1045",
    "src/simulation/coverage.ts:1735-1770",
    "src/simulation/coverage.ts:2230-2260"
  ],
  "mutator": {
    "excludedMutations": [
      "Regex"
    ]
  },
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "reporters": [
    "json",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/wave2-verification.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  },
  "timeoutMS": 20000,
  "concurrency": 12,
  "tempDirName": ".stryker-tmp-wave2",
  "cleanTempDir": true
}