] as const;

export type ConditionName = (typeof conditionNames)[number];
export type ExhaustionLevel = 1 | 2 | 3 | 4 | 5 | 6;

type SourceConditionName = 'Charmed' | 'Frightened' | 'Grappled';
type SimpleConditionName = Exclude<
