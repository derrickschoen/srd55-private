+    program: programSchema(0),
+  })),
+});
+
+function issuePath(path: readonly PropertyKey[]): string {
+  return path.reduce<string>((result, segment) =>
+    typeof segment === 'number' ? `${result}[${String(segment)}]` : `${result}.${String(segment)}`,
+  'round plan');
+}
