+      "attacks": [{ "attackId": "attack:quarterstaff", "kind": "melee", "attackBonus": 2, "criticalFloor": 20, "reachFeet": 5, "rangeFeet": 5, "damage": [{ "damageTypeId": "Bludgeoning", "count": 1, "sides": 6, "modifier": -1 }] }],
