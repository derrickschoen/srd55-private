+      combatantId: combatantIdSchema,
+      value: z.enum(['living', 'dying', 'stable', 'dead']),
+    }),
+    z.strictObject({
+      kind: z.literal('hp_percent_below'),
+      combatantId: combatantIdSchema,
+      percent: z.number().positive().max(100),
