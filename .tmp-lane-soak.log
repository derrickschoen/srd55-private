+    tables.push({
+      tableIndex,
+      seed: tableSeed,
+      partySource: partySource === 'reference' ? 'reference' : 'external-pack',
+      replayFile,
+      gapCount: gaps.length,
+      coordinatorPartySize: coordinator.state().combatants.filter(
+        (combatant) => combatant.profile.kind === 'player_character',
+      ).length,
+      proof,
