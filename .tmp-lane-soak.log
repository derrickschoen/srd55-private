+    };
+    candidate.members[0]!.feature = { kind: 'unsupported' };
+    const result = loadExternalPartyPack(candidate);
+
+    expect(result).toMatchObject({
+      status: 'refused',
+      refusal: { kind: 'external_party_pack_refusal', reason: 'gaps_not_allowed' },
+      gaps: [{
