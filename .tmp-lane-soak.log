+      const graceful = new Promise<'timeout'>((resolve) => {
+        timer = setTimeout(() => resolve('timeout'), 2_000);
+      });
+      const result = await Promise.race([exited.then(() => 'exited' as const), graceful]);
+      if (timer !== undefined) clearTimeout(timer);
