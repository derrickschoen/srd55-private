   262	function validateSpell(reference: MonsterSpellReference): MonsterSpellReference {
   263	  const row = SPELL_MANIFEST.find(({ id }) => id === reference.id);
   264	  if (row === undefined) throw new RangeError(`Monster spell ${reference.id} is absent from the spell manifest.`);
   265	  if (row.status !== reference.manifestStatus) throw new RangeError(`Monster spell ${reference.id} has the wrong manifest status.`);
   266	  return reference;
   267	}
