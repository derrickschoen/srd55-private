+| 18 | >20 | 21 | 266 (200–333) | +13 | 113 | 5 | 23 (4d10 + 1) |
+| 19 | >20 | 21 | 285 (214–356) | +13 | 119 | 5 | 24 (4d10 + 2) |
+| 20 | >20 | 21 | 300 (225–375) | +13 | 132 | 5 | 26 (4d12) |
