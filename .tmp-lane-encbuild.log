   226	const AUTHORED_ABSENCE = 'This authored statblock did not supply the SRD field.';
   227	const present = <T>(value: T): DecodedField<T> => ({ kind: 'present', value });
   228	const absent = <T>(note = AUTHORED_ABSENCE): DecodedField<T> => ({ kind: 'absent', note });
   229	
   230	function positiveInteger(value: number, label: string): number {
   231	  if (!Number.isSafeInteger(value) || value < 1) throw new RangeError(`${label} must be a positive safe integer.`);
   232	  return value;
   233	}
   234	
   235	function nonNegativeInteger(value: number, label: string): number {
   236	  if (!Number.isSafeInteger(value) || value < 0) throw new RangeError(`${label} must be a non-negative safe integer.`);
   237	  return value;
   238	}
   239	
   240	function finiteInteger(value: number, label: string): number {
   241	  if (!Number.isSafeInteger(value)) throw new RangeError(`${label} must be a safe integer.`);
   242	  return value;
   243	}
   244	
   245	function nonEmptyText(value: string, label: string): string {
   246	  if (value.trim().length === 0 || value.trim() !== value) throw new RangeError(`${label} must be trimmed and non-empty.`);
   247	  return value;
   248	}
   249	
   250	function validateDice(dice: MonsterDice, label: string): MonsterDice {
   251	  positiveInteger(dice.count, `${label} count`);
   252	  finiteInteger(dice.modifier, `${label} modifier`);
   253	  return dice;
   254	}
   255	
   256	function validateDecoded<T>(field: DecodedField<T>, label: string, validate: (value: T) => T): DecodedField<T> {
   257	  return field.kind === 'absent'
   258	    ? absent(nonEmptyText(field.note, `${label} absence note`))
   259	    : present(validate(field.value));
   260	}
