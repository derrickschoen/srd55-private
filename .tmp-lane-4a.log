        actorId: 'mover',
        start: { column: 0, row: 0 },
        path: [{ column: 1, row: 0 }],
        budgetRemaining: feet(10),
        cause: 'voluntary',
        reachSources: [],
      }),
    ).toEqual({
      kind: 'illegal',
      reason: 'occupied_destination',
      stepIndex: 0,
    });
  });
});

