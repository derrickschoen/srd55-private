+    const from = vertices[index];
+    const to = vertices[(index + 1) % vertices.length];
+    if (from === undefined || to === undefined) continue;
+    const fromInside = inside(from);
+    const toInside = inside(to);
+    if (fromInside && toInside) {
+      output.push(to);
+    } else if (fromInside) {
