+{
+  "shape": "cone",
+  "cases": [
+    {
+      "name": "cone exact tangency, board edge, and Large footprint",
+      "bounds": { "columns": 3, "rows": 3 },
+      "blockedCells": [],
+      "template": {
+        "origin": { "x": 0, "y": 5 },
+        "direction": { "x": 1, "y": 0 },
