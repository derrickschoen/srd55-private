+          ],
+          "affected": true
+        },
+        {
+          "id": "large-outside",
+          "occupiedCells": [
+            { "column": 3, "row": 2 },
+            { "column": 3, "row": 3 }
+          ],
+          "affected": false
+        }
+      ]
+    },
+    {
+      "name": "cube locations behind a full-height Total Cover wall",
+      "bounds": { "columns": 5, "rows": 3 },
+      "blockedCells": [
+        { "column": 1, "row": 0 },
+        { "column": 1, "row": 1 },
+        { "column": 1, "row": 2 }
+      ],
+      "template": {
+        "origin": { "x": 0, "y": 5 },
+        "center": { "x": 15, "y": 5 },
+        "axis": { "x": 1, "y": 0 },
+        "size": 30,
+        "includeOrigin": false
+      },
+      "expectedCells": [
+        { "column": 0, "row": 0 },
+        { "column": 0, "row": 1 },
+        { "column": 0, "row": 2 }
+      ],
+      "tangentIncluded": { "column": 0, "row": 2 },
+      "outsideExcluded": { "column": 2, "row": 1 },
+      "creatures": []
+    }
+  ]
+}
