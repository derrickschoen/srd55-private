+    grid,
+    origin,
+    polygonArea(
+      [
+        { x: origin.x - perpendicular.x * halfWidth, y: origin.y - perpendicular.y * halfWidth },
+        { x: end.x - perpendicular.x * halfWidth, y: end.y - perpendicular.y * halfWidth },
+        { x: end.x + perpendicular.x * halfWidth, y: end.y + perpendicular.y * halfWidth },
+        { x: origin.x + perpendicular.x * halfWidth, y: origin.y + perpendicular.y * halfWidth },
+      ],
