+
+function locationIsVisible(
+  area: ContinuousArea,
+  rectangle: Rectangle,
+  origin: Point,
+  obstacles: readonly Rectangle[],
+): boolean {
+  for (const angle of visibilityAngles(area, rectangle, origin, obstacles)) {
+    const direction = { x: Math.cos(angle), y: Math.sin(angle) };
