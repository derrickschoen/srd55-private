@@ -0,0 +1,63 @@
+{
+  "shape": "cylinder",
+  "cases": [
+    {
+      "name": "cylinder exact tangency, board edge, and Large footprint",
+      "bounds": { "columns": 4, "rows": 4 },
+      "blockedCells": [],
+      "template": {
+        "origin": { "x": 5, "y": 5 },
+        "radius": 5,
+        "height": 10
+      },
+      "expectedCells": [
+        { "column": 0, "row": 0 },
+        { "column": 1, "row": 0 },
+        { "column": 2, "row": 0 },
+        { "column": 0, "row": 1 },
+        { "column": 1, "row": 1 },
+        { "column": 2, "row": 1 },
