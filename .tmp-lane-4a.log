+  | { readonly shape: 'emanation'; readonly template: EmanationTemplate }
+  | { readonly shape: 'line'; readonly template: LineTemplate }
+  | { readonly shape: 'sphere'; readonly template: SphereTemplate };
+
+interface Point {
+  readonly x: number;
+  readonly y: number;
+}
+
