{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/simulation/**/*.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "reporters": [
    "json",
    "clear-text",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/stryker-simulation-run2.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  },
  "timeoutMS": 20000,
  "concurrency": 12,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "mutator": {
    "excludedMutations": [
      "Regex"
    ]
  }
}