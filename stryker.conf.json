{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [
    "typescript"
  ],
  "concurrency": 4,
  "dryRunTimeoutMinutes": 15,
  "testRunnerNodeArgs": [
    "--max-old-space-size=8192"
  ],
  "incremental": true,
  "inPlace": true,
  "thresholds": {
    "break": null
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "mutate": [
    "src/vtt/survival-policy.ts",
    "src/vtt/party-pack.ts",
    "src/combat/controllers.ts",
    "src/vtt/vane-warren.ts",
    "src/vtt/session-record.ts",
    "src/vtt/local-session-store.ts",
    "src/vtt/stable-dom-render.ts"
  ]
}
