{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [
    "typescript"
  ],
  "concurrency": 4,
  "incremental": true,
  "inPlace": true,
  "thresholds": {
    "break": null
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "mutate": [
    "src/access/**/*.ts",
    "src/eligibility/**/*.ts",
    "src/grants/**/*.ts",
    "src/rules/**/*.ts",
    "!src/rules/**/*-srd.ts"
  ]
}
